@prefix all: <http://data.ashrae.org/standard223/model/all#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology>
  a owl:Ontology ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
  owl:imports <http://qudt.org/3.3.0/vocab/unit> ;
  owl:imports <http://qudt.org/3.3.0/vocab/quantitykind> ;
  owl:imports <urn:nawi-water-ontology/equip> ;
  owl:imports <urn:nawi-water-ontology/processtypes> ;
  owl:imports <urn:nawi-water-ontology/outcomes> ;
  owl:imports <urn:nawi-water-ontology/class-defaults> ;
  owl:imports <urn:nawi-water-ontology/substances> ;
  owl:imports <urn:nawi-water-ontology/enumerationkinds> ;
  owl:imports sh: ;
.

watr:Class
  a rdfs:Class ;
  a sh:NodeShape ;
  rdfs:comment "This is a modeling construct. All classes defined in the watr ontology are instances of `watr:Class`." ;
  rdfs:label "Class" ;
  rdfs:subClassOf rdfs:Class ;
  sh:property [
      sh:path rdfs:label ;
      rdfs:comment "A `Class` must be associated with at least one label using the relation `rdfs:label`." ;
      sh:minCount 1 ;
      sh:severity sh:Warning ;
    ] ;
.

# A watr:hasProcess, watr:hasTreatmentObjective or s223:hasRole constraint that names a
# class which was never defined -- typically the leftover of a rename -- silently
# makes the equipment impossible to validate, because no value can ever carry the
# missing type and the shape itself still parses. This guards against that: every
# class such a constraint names must be defined somewhere in the import closure,
# which we test for by requiring it to have at least one rdf:type.
watr:ProcessAndRoleConstraintsReferenceDefinedClasses
    a sh:NodeShape ;
    rdfs:label "Process and role constraints reference defined classes" ;
    rdfs:comment "Every class named by a watr:hasProcess, watr:hasTreatmentObjective or s223:hasRole constraint must be defined." ;
    sh:targetSubjectsOf sh:path ;
    sh:or (
        # Not a process/outcome/role property shape, so there is nothing to check.
        [
            sh:not [
                sh:property [
                    sh:path sh:path ;
                    sh:in ( watr:hasProcess watr:hasTreatmentObjective s223:hasRole ) ;
                    sh:minCount 1 ;
                ] ;
            ] ;
        ]
        [
            sh:property [
                sh:path sh:class ;
                sh:node watr:DefinedClassShape ;
            ] ;
            sh:property [
                sh:path ( sh:qualifiedValueShape sh:class ) ;
                sh:node watr:DefinedClassShape ;
            ] ;
            sh:property [
                sh:path sh:hasValue ;
                sh:node watr:DefinedClassShape ;
            ] ;
            # Cover list-valued constraints as well as sh:class/sh:hasValue.
            # Both the direct form and the qualified form occur in SHACL.
            sh:property [
                sh:path (
                    sh:in
                    [ sh:zeroOrMorePath rdf:rest ]
                    rdf:first
                ) ;
                sh:node watr:DefinedClassShape ;
            ] ;
            sh:property [
                sh:path (
                    sh:qualifiedValueShape
                    sh:in
                    [ sh:zeroOrMorePath rdf:rest ]
                    rdf:first
                ) ;
                sh:node watr:DefinedClassShape ;
            ] ;
        ]
    ) ;
    sh:message "A watr:hasProcess, watr:hasTreatmentObjective or s223:hasRole constraint names a class that is not defined anywhere (check for a rename)." ;
.

watr:DefinedClassShape
    a sh:NodeShape ;
    rdfs:label "Defined class" ;
    rdfs:comment "A class that exists: it carries at least one rdf:type." ;
    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:message "This class is referenced by a shape but is never defined." ;
    ] ;
.

# Plausibility of *additional* processes.
#
# watr:hasProcess constraints say "performs at least this process", so they
# permit any number of further processes -- deliberately, because real equipment
# does more than its defining process (a filter backwashes, a digester mixes).
# The cost is that nothing objects to an implausible one, e.g. a ChlorinationUnit
# declaring reverse osmosis.
#
# watr:mayAlsoPerform closes that gap without narrowing the ontology. An
# equipment class lists the process families it may perform *in addition* to the
# one it requires, and the shape below warns about values that fall outside the
# union of (what the class or any ancestor requires) and (what they may also
# perform). Declaring it on the abstract families -- Tank, Reactor, Filter,
# Digester, SeparationTank -- covers their subclasses by inheritance; a subclass
# only needs its own statement when it genuinely does something its family does
# not. See docs/explanation/processes.md.
#
# This is deliberately sh:Warning, not sh:Violation: implausible is not
# impossible, and a real plant may do something the ontology did not anticipate.
watr:mayAlsoPerform
    a rdf:Property ;
    rdfs:label "may also perform" ;
    rdfs:comment "Relates an equipment class to a process it may perform in addition to the process it requires. Used for plausibility warnings, not validity." ;
    rdfs:domain watr:Class ;
    rdfs:range watr:Class ;
.

<urn:nawi-water-ontology>
    sh:declare [ sh:prefix "watr" ; sh:namespace "urn:nawi-water-ontology#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "sh" ; sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "s223" ; sh:namespace "http://data.ashrae.org/standard223#"^^xsd:anyURI ] ;
.

# Some processes are performed by a *collection* of equipment and by no single
# member of it. A backwash pump only pumps and a backwash tank only holds water;
# backwashing is what the assembly does. Such a process is asserted on the
# s223:System, which is why watr:hasProcess is not restricted to Equipment.
#
# watr:includesProcess records what a compound process decomposes into, stated
# once on the process type rather than repeated in every model. It is what gives
# the treatment-train process types (Process-MLE, Process-A2O, the Bardenphos)
# content beyond a label: an MLE is not a thing a machine does, it is an
# arrangement of nitrification, denitrification and recycle across several.
#
# Not to be confused with a subclass relation: a compound process *comprises*
# its parts, it is not a kind of them. Nor with plausibility -- watr:mayAlsoPerform
# grants permission to one piece of equipment, whereas this says what a train is
# made of.
watr:includesProcess
    a rdf:Property ;
    rdfs:label "includes process" ;
    rdfs:comment "Relates a compound process to a constituent process that a system performing it is expected to carry out, typically through a member. Used to check coverage, not validity." ;
    rdfs:domain watr:Class ;
    rdfs:range watr:Class ;
.

# What a piece of equipment is *for*, as distinct from what it does.
#
# One process serves several treatment objectives and one treatment objective is reached by several
# processes: a primary clarifier, a secondary clarifier and a gravity thickener
# all settle, and chlorination, ozonation and ultraviolet irradiation all
# disinfect. Neither relation fits in a single hierarchy, so treatment objectives are a
# separate vocabulary in water/outcomes.ttl and no term belongs to both.
#
# Treatment objective and process are both intrinsic -- on the datasheet. What is positional
# belongs to s223:hasRole: a primary and a secondary clarifier share their
# treatment objective and their process, and differ in their role.
#
# See docs/explanation/processes.md.
watr:hasTreatmentObjective
    a rdf:Property ;
    rdfs:label "has treatment objective" ;
    rdfs:comment "Associates a piece of equipment or a system with the treatment objective it is intended to achieve. What it does to achieve that is watr:hasProcess." ;
.

# The class-level counterpart: what a process type achieves wherever it is used.
# Stated on the process rather than repeated on every piece of equipment that
# performs it. Left off deliberately where what a process achieves depends on the
# equipment -- Process-ChemicalPrecipitation serves phosphorus removal in one
# machine and metals removal in another.
watr:achievesTreatmentObjective
    a rdf:Property ;
    rdfs:label "achieves treatment objective" ;
    rdfs:comment "Relates a process type to the treatment objective it achieves wherever it is performed. Used to derive an equipment's treatment objective from its process." ;
    rdfs:domain watr:Class ;
    rdfs:range watr:Class ;
.

# The consumer of watr:achievesTreatmentObjective. If a process achieves a treatment objective wherever
# it is performed, then equipment performing it has that objective whether or not
# the model says so, and a model that leaves it unsaid is incomplete rather than
# wrong -- hence a warning.
#
# The check runs in this direction only. The converse, requiring every stated
# treatment objective to be achieved by some stated process, would be wrong: most treatment objectives
# are not derivable from the mechanism, which is the whole reason they are a
# separate axis. Sedimentation serves clarification and thickening alike, so
# watr:achievesTreatmentObjective says nothing about it and a clarifier's objective can only
# be stated, never inferred.
watr:TreatmentObjectiveCompletenessShape
    a sh:NodeShape ;
    rdfs:label "Stated processes imply stated treatment objectives" ;
    rdfs:comment "Warns when equipment performs a process that achieves a treatment objective the equipment does not state." ;
    sh:targetSubjectsOf watr:hasProcess ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <urn:nawi-water-ontology> ;
        sh:message "{$this} performs {?process}, which achieves treatment objective {?objective}, but does not state it. Add watr:hasTreatmentObjective {?objective}." ;
        # A stated treatment objective related to the achieved one in either direction
        # counts: more specific is a refinement, more general is entailed.
        sh:select """
            SELECT $this ?process ?objective
            WHERE {
                $this watr:hasProcess ?process .
                ?process rdfs:subClassOf*/watr:achievesTreatmentObjective ?objective .
                FILTER NOT EXISTS {
                    $this watr:hasTreatmentObjective ?stated .
                    { ?stated rdfs:subClassOf* ?objective }
                    UNION
                    { ?objective rdfs:subClassOf* ?stated }
                }
            }
        """ ;
    ] ;
.

# watr:hasProcess and watr:hasTreatmentObjective are only meaningful on something that can
# perform a process. Expressed as a shape rather than rdfs:domain deliberately:
# an OWL domain would *infer* s223:Equipment onto whatever bears the property
# instead of rejecting it, which is the opposite of a guard.
watr:ProcessBearerShape
    a sh:NodeShape ;
    rdfs:label "Process bearers are equipment or systems" ;
    rdfs:comment "watr:hasProcess and watr:hasTreatmentObjective may only be asserted on an s223:Equipment or an s223:System." ;
    sh:targetSubjectsOf watr:hasProcess ;
    sh:targetSubjectsOf watr:hasTreatmentObjective ;
    sh:or (
        [ sh:class s223:Equipment ]
        [ sh:class s223:System ]
    ) ;
    sh:message "watr:hasProcess and watr:hasTreatmentObjective may only be asserted on s223:Equipment or s223:System. A process is performed by a machine or by a collection of them." ;
.

# The bearer guard above constrains the subject. These companion guards constrain
# the objects, including for s223:System, which does not inherit UnitProcess's
# all-values sh:class constraint. They are also what keeps the two vocabularies
# from being used interchangeably: a treatment objective asserted with watr:hasProcess is
# rejected here, and a process asserted with watr:hasTreatmentObjective likewise.
watr:ProcessValueShape
    a sh:NodeShape ;
    rdfs:label "Process values are water processes" ;
    rdfs:comment "Every object of watr:hasProcess must be a watr:Process." ;
    sh:targetObjectsOf watr:hasProcess ;
    sh:class watr:Process ;
    sh:message "Every value of watr:hasProcess must be a watr:Process. An objective belongs on watr:hasTreatmentObjective." ;
.

watr:TreatmentObjectiveValueShape
    a sh:NodeShape ;
    rdfs:label "Treatment objective values are treatment objectives" ;
    rdfs:comment "Every object of watr:hasTreatmentObjective must be a watr:TreatmentObjective." ;
    sh:targetObjectsOf watr:hasTreatmentObjective ;
    sh:class watr:TreatmentObjective ;
    sh:message "Every value of watr:hasTreatmentObjective must be a watr:TreatmentObjective. An activity belongs on watr:hasProcess." ;
.

# A treatment objective is reached by doing something. Equipment that states only what it is
# for, without saying how, has said nothing checkable.
watr:TreatmentObjectiveRequiresProcessShape
    a sh:NodeShape ;
    rdfs:label "A treatment objective is reached by a process" ;
    rdfs:comment "Equipment declaring watr:hasTreatmentObjective must also declare the watr:hasProcess by which it reaches it." ;
    sh:targetSubjectsOf watr:hasTreatmentObjective ;
    # Named rather than a blank node so that sh:sourceShape on the result
    # identifies it: for a sh:property constraint the source is the property
    # shape, not the node shape that carries it.
    sh:property watr:TreatmentObjectiveRequiresProcessProperty ;
.

watr:TreatmentObjectiveRequiresProcessProperty
    a sh:PropertyShape ;
    sh:path watr:hasProcess ;
    sh:minCount 1 ;
    sh:message "watr:hasTreatmentObjective says what the equipment is for, so the process it does to get there must be stated with watr:hasProcess as well." ;
.

watr:SystemProcessCoverageShape
    a sh:NodeShape ;
    rdfs:label "System process coverage" ;
    rdfs:comment "Warns when a system claims a compound process but nothing in it performs one of the constituent processes." ;
    sh:targetClass s223:System ;
    # As with ProcessPlausibilityShape, sh:severity must sit on the NodeShape.
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <urn:nawi-water-ontology> ;
        sh:message "{$this} claims a process that includes {?missing}, but neither it nor any member performs that process." ;
        # hasMember* rather than hasMember+: the zero-length match makes the
        # system itself a candidate performer, since a train may state a step
        # directly instead of through a member. Nested subsystems are covered by
        # the transitive part.
        #
        # Compound processes include their steps; they are not subclasses of
        # those steps. This keeps the claimed compound process from satisfying
        # its own coverage requirement.
        sh:select """
            SELECT $this ?missing
            WHERE {
                $this watr:hasProcess ?claimed .
                ?claimed rdfs:subClassOf*/watr:includesProcess ?missing .
                FILTER NOT EXISTS {
                    $this s223:hasMember* ?performer .
                    ?performer watr:hasProcess ?actual .
                    ?actual rdfs:subClassOf* ?missing .
                }
            }
        """ ;
    ] ;
.

watr:ProcessPlausibilityShape
    a sh:NodeShape ;
    rdfs:label "Process plausibility" ;
    rdfs:comment "Warns when equipment declares a process that its family neither requires nor permits via watr:mayAlsoPerform." ;
    sh:targetSubjectsOf watr:hasProcess ;
    # Warning, not Violation -- see the note on watr:mayAlsoPerform above. Note
    # sh:severity has to sit on the NodeShape; on the SPARQLConstraint it is
    # ignored and the result comes back as a Violation.
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <urn:nawi-water-ontology> ;
        sh:message "{$this} declares {?value}, which its equipment class neither requires nor lists via watr:mayAlsoPerform. If this is legitimate, add a watr:mayAlsoPerform statement to the appropriate equipment class." ;
        # watr:Process is excluded throughout: watr:UnitProcess requires it of
        # every value, so counting it as "allowed" would permit every process
        # and make this check vacuous.
        sh:select """
            SELECT $this ?value
            WHERE {
                $this watr:hasProcess ?value .

                # Only judge equipment whose family says something about processes.
                FILTER EXISTS {
                    $this rdf:type/rdfs:subClassOf* ?known .
                    {
                        ?known sh:property ?kps .
                        ?kps sh:path watr:hasProcess .
                        {
                            ?kps sh:qualifiedValueShape/sh:class ?k .
                        } UNION {
                            ?kps sh:class ?k .
                        } UNION {
                            ?kps sh:qualifiedValueShape/sh:in/rdf:rest*/rdf:first ?k .
                        }
                    } UNION {
                        ?known watr:mayAlsoPerform ?k .
                    }
                    FILTER ( ?k != watr:Process )
                }

                # Flag values outside the union of required and permitted.
                FILTER NOT EXISTS {
                    $this rdf:type/rdfs:subClassOf* ?anc .
                    {
                        ?anc sh:property ?ps .
                        ?ps sh:path watr:hasProcess .
                        {
                            ?ps sh:qualifiedValueShape/sh:class ?allowed .
                        } UNION {
                            ?ps sh:class ?allowed .
                        } UNION {
                            ?ps sh:qualifiedValueShape/sh:in/rdf:rest*/rdf:first ?allowed .
                        }
                    } UNION {
                        ?anc watr:mayAlsoPerform ?allowed .
                    }
                    FILTER ( ?allowed != watr:Process )
                    ?value rdfs:subClassOf* ?allowed .
                }
            }
        """ ;
    ] ;
.

watr:UnitProcess
    a rdfs:Class ;
    rdfs:label "Unit Process" ;
    rdfs:comment "A unit process is a specific type of water treatment process that can be applied to water." ;
    rdfs:subClassOf watr:Class, s223:Equipment ;
    sh:property [
      sh:path watr:hasProcess ;
      sh:minCount 1 ;
      sh:message "A `Unit Process` must be associated with at least one water treatment process using the relation `watr:hasProcess`." ;
      sh:class watr:Process ;
    ] ;
.

s223:QuantifiableProperty
  sh:property [
     sh:path watr:hasTemporalResolution ;
     rdfs:comment "The `hasTemporalResolution` relation is used to link to a numerical `Property` whose value indicates the minimum time interval between successive measurements or data points." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
    sh:property [
     sh:path watr:hasNumericResolution ;
     rdfs:comment "The `hasNumericResolution` relation is used to link to a numerical `Property` whose value indicates the smallest distinguishable difference between two measured values in engineering units." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasTemporalRange ;
     rdfs:comment "The `hasTemporalRange` relation is used to link to a numerical `Property` whose value indicates the start and end times for which data has been recorded." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasNumericRange ;
     rdfs:comment "The `hasNumericRange` relation is used to link to a numerical `Property` whose value indicates the span between the minimum and maximum measured values." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasVariableRange ;
     rdfs:comment "The `hasVariableRange` relation is used to link to a numerical `Property` whose value indicates the maximum or minimum for the measured variable during normal operation." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasMeasurementRange ;
     rdfs:comment "The `hasMeasurementRange` relation is used to link to a numerical `Property` whose value indicates the maximum or minimum that can physically be measured, e.g. by a sensor." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasProcessedData ;
     rdfs:comment "The `hasProcessedData` relation is used to link to a `Property` that describes any data processing, filtering, or transformation applied to the raw measurement values." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasAccuracy ;
     rdfs:comment "The `hasAccuracy` relation is used to link to a numerical `Property` whose value indicates the maximum expected deviation between the measured value and the true value in engineering units." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasPrecision ;
     rdfs:comment "The `hasPrecision` relation is used to link to a numerical `Property` whose value indicates the repeatability or reproducibility of measurements under identical conditions." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasBias ;
     rdfs:comment "The `hasBias` relation is used to link to a numerical `Property` whose value indicates the systematic offset or drift in measurements relative to the true value." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
     sh:path watr:hasResponseTime ;
     rdfs:comment "The `hasResponseTime` relation is used to link to a numerical `Property` whose value indicates the time required for the sensor or measurement system to respond to a step change in the measured variable." ;
     sh:class s223:QuantifiableProperty ;
   ] ;
   sh:property [
    sh:path watr:hasCalibrationCurve ;
    rdfs:comment "The `hasCalibrationCurve` relation is used to link to a `Property` that describes the mathematical relationship or lookup table between raw sensor output and calibrated engineering units." ;
    sh:class s223:QuantifiableProperty ;
  ] ;
   sh:property [
    sh:path watr:hasDropRate ;
    rdfs:comment "The `hasDropRate` relation is used to link to a `Property` describes the amount of data points lost within a range of time due to latencies or other factors." ;
    sh:class s223:QuantifiableProperty ;
  ] ;
   sh:property [
     sh:path watr:hasAggregation ;
     rdfs:comment "If present, `hasAggregation` associates a quantifiable property with one aggregation semantics such as total, mean, maximum, or minimum." ;
     sh:class watr:EnumerationKind-Aggregation ;
     sh:maxCount 1 ;
   ] ;
.

s223:Sensor
  sh:property [
      sh:path watr:hasMeasurementRange ;
      rdfs:comment "The `hasMeasurementRange` relation is used to link to a numerical `Property` whose value indicates the maximum or minimum that can physically be measured, e.g. by a sensor." ;
      sh:class s223:QuantifiableProperty ;
    ] ;
  .
watr:hasProcess
  a rdf:Property ;
  rdfs:label "has process" ;
  rdfs:comment "Associates a water treatment process with the entity that performs it: a piece of Equipment, or an s223:System where the process is performed by the collection and by no individual member (backwashing, or a treatment train such as an MLE). See watr:ProcessBearerShape and watr:ProcessValueShape." ;
.

watr:hasAggregation
  a rdf:Property ;
  rdfs:comment "The `hasAggregation` relation associates a property with water-specific aggregation semantics such as total, mean, maximum, or minimum." ;
  rdfs:label "has aggregation" ;
.

watr:hasTemporalResolution
  a rdf:Property ;
  rdfs:comment "The `hasTemporalResolution` relation is used to link to a numerical `Property` whose value indicates the minimum time interval between successive measurements or data points." ;
  rdfs:label "has temporal resolution" ;
.
watr:hasTemporalRange
  a rdf:Property ;
  rdfs:comment "The `hasTemporalRange` relation is used to link to a numerical `Property` whose value indicates the start and end times for which data has been recorded." ;
  rdfs:label "has temporal range" ;
.

watr:hasNumericResolution
  a rdf:Property ;
  rdfs:comment "The `hasNumericResolution` relation is used to link to a numerical `Property` whose value indicates the smallest distinguishable difference between two measured values in engineering units." ;
  rdfs:label "has numeric resolution" ;
.

watr:hasNumericRange
  a rdf:Property ;
  rdfs:comment "The `hasNumericRange` relation is used to link to a numerical `Property` whose value indicates the span between the minimum and maximum measurable values in engineering units." ;
  rdfs:label "has numeric range" ;
.

watr:hasVariableRange
  a rdf:Property ;
  rdfs:comment "The `hasVariableRange` relation is used to link to a numerical `Property` whose value indicates the expected range of variation for the measured variable under normal operating conditions." ;
  rdfs:label "has variable range" ;
.
watr:hasMeasurementRange
  a rdf:Property ;
  rdfs:comment "The `hasMeasurementRange` relation is used to link to a numerical `Property` whose value indicates the expected range of variation that can physically be measured, e.g. by a sensor." ;
  rdfs:label "has measurement range" ;
.

watr:hasProcessedData
  a rdf:Property ;
  rdfs:comment "The `hasProcessedData` relation is used to link to a `Property` that describes any data processing, filtering, or transformation applied to the raw measurement values." ;
  rdfs:label "has processed data" ;
.

watr:hasAccuracy
  a rdf:Property ;
  rdfs:comment "The `hasAccuracy` relation is used to link to a numerical `Property` whose value indicates the maximum expected deviation between the measured value and the true value in engineering units." ;
  rdfs:label "has accuracy" ;
.

watr:hasPrecision
  a rdf:Property ;
  rdfs:comment "The `hasPrecision` relation is used to link to a numerical `Property` whose value indicates the repeatability or reproducibility of measurements under identical conditions." ;
  rdfs:label "has precision" ;
.

watr:hasBias
  a rdf:Property ;
  rdfs:comment "The `hasBias` relation is used to link to a numerical `Property` whose value indicates the systematic offset or drift in measurements relative to the true value." ;
  rdfs:label "has bias" ;
.

watr:hasResponseTime
  a rdf:Property ;
  rdfs:comment "The `hasResponseTime` relation is used to link to a numerical `Property` whose value indicates the time required for the sensor or measurement system to respond to a step change in the measured variable." ;
  rdfs:label "has response time" ;
.

watr:hasCalibrationCurve
  a rdf:Property ;
  rdfs:comment "The `hasCalibrationCurve` relation is used to link to a `Property` that describes the mathematical relationship or lookup table between raw sensor output and calibrated engineering units." ;
  rdfs:label "has calibration curve" ;
.
watr:hasDropRate
  a rdf:Property ;
  rdfs:comment "The `hasDropRate` relation is used to link to a `Property` describes the amount of data points lost within a range of time due to latencies or other factors." ;
  rdfs:label "has drop rate" ;
.
