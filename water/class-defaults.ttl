@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology/class-defaults>
    a owl:Ontology ;
    rdfs:label "NAWI Water Class Defaults" ;
    rdfs:comment "SHACL-AF rules that materialize an instance's process and treatment objective from the requirements of its class and from the processes it performs" ;
.

# Two rules, and they answer the two questions a model does not have to restate.
#
#   watr:ClassDefaultsRule       what does this class of equipment do, and what
#                                is every unit of it built for?
#   watr:ProcessObjectiveRule    what does performing this process always
#                                achieve, whatever performs it?
#
# The first reads the class; the second reads the process. A chlorine contact
# tank gets its objective from both, which is not a conflict: the same triple
# arrives twice.

# Typing something as a watr:GravityThickener already says it thickens by
# settling -- that is what the class means. This rule writes those triples onto
# the instance so a model need not repeat them:
#
#     ex:gt a watr:GravityThickener .
#
#   becomes
#
#     ex:gt a watr:GravityThickener ;
#         watr:hasProcess watr:Process-Sedimentation ;   # from GravityThickener
#         watr:hasTreatmentObjective watr:TreatmentObjective-Thickening .      # inherited from Thickener
#
# The values are read from the sh:qualifiedValueShape constraints the classes
# already carry, so there is nothing to keep in step: adding a requirement to a
# class extends the rule automatically, and an ancestor's requirement is picked
# up through rdfs:subClassOf*.
#
# ---------------------------------------------------------------------------
# This file is part of the ontology's import closure, so the rule runs wherever
# the ontology is used. shifty.validate executes SHACL-AF rules as part of
# validation (infer=True by default), which means the values below are in place
# before the constraints are evaluated.
#
# The consequence is worth understanding: a class's process and treatment objective
# requirements can no longer fail for an instance that merely declares its type.
#
#     ex:gt a watr:GravityThickener .        # complete, by derivation
#
# That is intended. If watr:GravityThickener requires Process-Sedimentation, then
# an instance of it sediments whether or not the model troubles to say so, and
# the requirement is a definition rather than something to check. What the
# ontology no longer distinguishes is a model that *states* what a piece of
# equipment does from one that only types it -- validate against the ontology
# without this file if you need that distinction.
# ---------------------------------------------------------------------------
watr:ClassDefaultsRule
    a sh:NodeShape ;
    rdfs:label "Class defaults" ;
    rdfs:comment "Materializes watr:hasProcess and watr:hasTreatmentObjective onto an instance from the qualified requirements of its class and that class's ancestors." ;
    sh:targetClass s223:Equipment ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "Infer required process and treatment objective from the class" ;
        sh:prefixes <urn:nawi-water-ontology> ;
        # The FILTER NOT EXISTS gives these default semantics rather than
        # additive ones: a class requiring Process-Filtration adds nothing to an
        # instance that already declares Process-Microfiltration, since the
        # specific value already satisfies the general requirement.
        sh:construct """
            CONSTRUCT { $this ?pred ?value . }
            WHERE {
                VALUES ?pred { watr:hasProcess watr:hasTreatmentObjective }
                $this rdf:type/rdfs:subClassOf* ?cls .
                ?cls sh:property ?ps .
                ?ps sh:path ?pred ;
                    sh:qualifiedValueShape/sh:class ?value ;
                    sh:qualifiedMinCount ?min .
                FILTER ( ?min > 0 )
                FILTER NOT EXISTS {
                    $this ?pred ?existing .
                    ?existing rdfs:subClassOf* ?value .
                }
            }
        """ ;
    ] ;
.

# ---------------------------------------------------------------------------
# The second rule: what a process achieves, wherever it is performed.
#
# Some processes always produce the same result, and say so with
# watr:achievesTreatmentObjective -- denitrification always removes nitrogen,
# chlorination always disinfects, digestion always stabilizes. The ontology
# declares that only where the name of the process already names the result;
# filtration, sedimentation and the membrane processes declare nothing, because
# what they achieve depends on the unit.
#
#     ex:anoxicZone a watr:MixingBasin ;
#         watr:hasProcess watr:Process-Denitrification .
#
#   becomes
#
#     ex:anoxicZone a watr:MixingBasin ;
#         watr:hasProcess watr:Process-Mixing ;              # from MixingBasin
#         watr:hasProcess watr:Process-Denitrification ;
#         watr:hasTreatmentObjective watr:TreatmentObjective-NitrogenRemoval .
#
# This replaced a warning that fired when the model performed such a process and
# did not state the objective. Deriving it is better than complaining about it:
# the vocabulary already knows the answer, so a model that leaves it out is not
# incomplete, and asking every modeler to copy it out was asking them to repeat
# the ontology.
#
# Note what the rule does NOT do, which is the converse: it never infers a
# process from a stated objective. Most objectives are not derivable from the
# mechanism, which is the whole reason they are a separate axis. Sedimentation
# serves clarification and thickening alike, so a clarifier's objective can only
# be stated or inherited from its class, never worked out from what it does.
#
# Targeted by watr:hasProcess rather than by class, so that it reaches an
# s223:System as well as equipment: a train carrying Process-A2O gets nitrogen
# and phosphorus removal the same way its zones do. watr:ClassDefaultsRule
# targets s223:Equipment, because only equipment has a class that requires
# anything.
#
# The two rules compose because shifty runs rules to a fixed point: a bare
# ex:tank a watr:ChlorinationUnit has no watr:hasProcess to target until the
# first rule supplies Process-Chlorination, and this rule then sees it on the
# next pass.
#
# No FILTER NOT EXISTS here, unlike the rule above. A class requirement is a
# minimum, so a more specific stated value satisfies it and the default is
# suppressed. An entailment is not a minimum: if the process achieves the
# objective then the unit has it, and there is nothing for a stated value to
# override.
watr:ProcessObjectiveRule
    a sh:NodeShape ;
    rdfs:label "Objective from process" ;
    rdfs:comment "Materializes watr:hasTreatmentObjective onto anything that performs a process which declares watr:achievesTreatmentObjective." ;
    sh:targetSubjectsOf watr:hasProcess ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "Infer the treatment objective from the process performed" ;
        sh:prefixes <urn:nawi-water-ontology> ;
        # rdfs:subClassOf* so that a specific process inherits the entailment of
        # its parent: Process-UCT declares nitrogen and phosphorus removal
        # through Process-A2O, and organics removal through Process-ActivatedSludge
        # above that.
        sh:construct """
            CONSTRUCT { $this watr:hasTreatmentObjective ?objective . }
            WHERE {
                $this watr:hasProcess ?process .
                ?process rdfs:subClassOf*/watr:achievesTreatmentObjective ?objective .
            }
        """ ;
    ] ;
.
