@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology/class-defaults>
    a owl:Ontology ;
    rdfs:label "NAWI Water Class Defaults" ;
    rdfs:comment "SHACL-AF rules that materialize an instance's process and outcome from the requirements of its class" ;
.

# Typing something as a watr:GravityThickener already says it thickens by
# settling -- that is what the class means. This rule writes those triples onto
# the instance so a model need not repeat them:
#
#     ex:gt a watr:GravityThickener .
#
#   becomes
#
#     ex:gt a watr:GravityThickener ;
#         watr:hasProcess watr:Process-Sedimentation ;   # from GravityThickener
#         watr:hasOutcome watr:Outcome-Thickening .      # inherited from Thickener
#
# The values are read from the sh:qualifiedValueShape constraints the classes
# already carry, so there is nothing to keep in step: adding a requirement to a
# class extends the rule automatically, and an ancestor's requirement is picked
# up through rdfs:subClassOf*.
#
# ---------------------------------------------------------------------------
# This file is part of the ontology's import closure, so the rule runs wherever
# the ontology is used. shifty.validate executes SHACL-AF rules as part of
# validation (infer=True by default), which means the values below are in place
# before the constraints are evaluated.
#
# The consequence is worth understanding: a class's process and outcome
# requirements can no longer fail for an instance that merely declares its type.
#
#     ex:gt a watr:GravityThickener .        # complete, by derivation
#
# That is intended. If watr:GravityThickener requires Process-Sedimentation, then
# an instance of it sediments whether or not the model troubles to say so, and
# the requirement is a definition rather than something to check. What the
# ontology no longer distinguishes is a model that *states* what a piece of
# equipment does from one that only types it -- validate against the ontology
# without this file if you need that distinction.
# ---------------------------------------------------------------------------
watr:ClassDefaultsRule
    a sh:NodeShape ;
    rdfs:label "Class defaults" ;
    rdfs:comment "Materializes watr:hasProcess and watr:hasOutcome onto an instance from the qualified requirements of its class and that class's ancestors." ;
    sh:targetClass s223:Equipment ;
    sh:rule [
        a sh:SPARQLRule ;
        rdfs:label "Infer required process and outcome from the class" ;
        sh:prefixes <urn:nawi-water-ontology> ;
        # The FILTER NOT EXISTS gives these default semantics rather than
        # additive ones: a class requiring Process-Filtration adds nothing to an
        # instance that already declares Process-Microfiltration, since the
        # specific value already satisfies the general requirement.
        sh:construct """
            CONSTRUCT { $this ?pred ?value . }
            WHERE {
                VALUES ?pred { watr:hasProcess watr:hasOutcome }
                $this rdf:type/rdfs:subClassOf* ?cls .
                ?cls sh:property ?ps .
                ?ps sh:path ?pred ;
                    sh:qualifiedValueShape/sh:class ?value ;
                    sh:qualifiedMinCount ?min .
                FILTER ( ?min > 0 )
                FILTER NOT EXISTS {
                    $this ?pred ?existing .
                    ?existing rdfs:subClassOf* ?value .
                }
            }
        """ ;
    ] ;
.
