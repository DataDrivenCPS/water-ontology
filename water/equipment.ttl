@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology/equip>
    a owl:Ontology ;
    rdfs:label "NAWI Water Equipment Ontology" ;
    rdfs:comment "An ontology for water equipment used in the NAWI project" ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
    owl:imports <urn:nawi-water-ontology/processtypes> ;
.
# Despite the name, watr:Tank asserts nothing about geometry or containment. Its
# constraints are entirely about connection points: one fluid inlet and one fluid
# outlet, plus rules for the optional drain and overflow. Anything fluid flows
# through therefore qualifies, including in-line devices -- watr:StaticMixer and
# watr:PlugFlowReactor are both Tanks by way of watr:Reactor. Read it as "a
# flow-through vessel", not as a shape. See water/notes.md.
watr:Tank a sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Tank" ;
    rdfs:comment "A flow-through vessel with at least one fluid inlet and one fluid outlet. Names a connection-point pattern rather than a geometry: in-line devices such as static mixers qualify." ;
    rdfs:subClassOf s223:Equipment ;
    # Any tank may be drained or purged for maintenance. Inherited by every tank
    # subclass; see watr:mayAlsoPerform in ontology.ttl.
    watr:mayAlsoPerform watr:Process-Cleaning ;
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A tank has an inlet fluid connection point" ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class s223:InletConnectionPoint ;
            sh:property [
                sh:path s223:hasMedium ;
                sh:class s223:Mix-Fluid ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A tank has an outlet fluid connection point" ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class s223:OutletConnectionPoint ;
            sh:property [
                sh:path s223:hasMedium ;
                sh:class s223:Mix-Fluid ;
            ] ;
            sh:not [
                # this is NOT a drain connection point! Tanks with a drain connection point must have a separate outlet connection point for the drain.
                sh:property [
                    sh:path s223:hasRole ;
                    sh:hasValue watr:Role-Drain ;
                    sh:minCount 1 ;
                ] ;
            ] ;
        ] ;
    ] ;
    # A drain is optional, but every drain must be a fluid outlet. The constraint
    # permits zero counterexamples: drain-role points that are not fluid outlets.
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A tank's drain connection point, if it has one, is a fluid outlet" ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path s223:hasRole ;
                sh:hasValue watr:Role-Drain ;
                sh:minCount 1 ;
            ] ;
            sh:not [
                sh:class s223:OutletConnectionPoint ;
                sh:property [
                    sh:path s223:hasMedium ;
                    sh:class s223:Mix-Fluid ;
                    sh:minCount 1 ;
                ] ;
            ] ;
        ] ;
        sh:message "A drain connection point on a Tank must be an outlet carrying a fluid." ;
    ] ;
    # Same treatment for the optional overflow connection point.
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A tank's overflow connection point, if it has one, is a fluid outlet" ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path s223:hasRole ;
                sh:hasValue watr:Role-Overflow ;
                sh:minCount 1 ;
            ] ;
            sh:not [
                sh:class s223:OutletConnectionPoint ;
                sh:property [
                    sh:path s223:hasMedium ;
                    sh:class s223:Mix-Fluid ;
                    sh:minCount 1 ;
                ] ;
            ] ;
        ] ;
        sh:message "An overflow connection point on a Tank must be an outlet carrying a fluid." ;
    ] ;
.

watr:Reactor a sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Reactor" ;
    rdfs:comment "A vessel in which a reaction or biological/chemical treatment process takes place" ;
    # rdfs:subClassOf watr:Tank does not claim a reactor is tank-shaped -- see the
    # note on watr:Tank above. It claims only that fluid flows through it via an
    # inlet and an outlet, which holds for tubular reactors and in-line mixers as
    # much as for basins.
    rdfs:subClassOf watr:Tank, watr:UnitProcess;
    # Reactors routinely mix, aerate and recirculate alongside whatever reaction
    # defines them. Digesters and disinfection units inherit this.
    watr:mayAlsoPerform watr:Process-Mixing, watr:Process-Aeration, watr:Process-Recirculation ;
    # The biological conversions that a zone in a nutrient-removal train carries
    # out. A train states the compound process on the system, and
    # watr:includesProcess expands it into these steps, which the coverage check
    # then looks for on the members. They are permitted rather than required
    # because which zone nitrifies or denitrifies is an operating regime, not a
    # property of the vessel.
    watr:mayAlsoPerform watr:Process-Nitrification, watr:Process-Denitrification,
                        watr:Process-EnhancedBiologicalPhosphorusRemoval ;
    # Recirculation and return connection points are optional, but every such
    # point must be a fluid outlet. The constraint permits zero counterexamples.
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A reactor's recirculation or return connection points, if any, are fluid outlets" ;
        sh:qualifiedMaxCount 0 ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path s223:hasRole ;
                sh:qualifiedValueShape [ sh:in ( s223:Role-Recirculating s223:Role-Return ) ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
            sh:not [
                sh:class s223:OutletConnectionPoint ;
                sh:property [
                    sh:path s223:hasMedium ;
                    sh:class s223:Mix-Fluid ;
                    sh:minCount 1 ;
                ] ;
            ] ;
        ] ;
        sh:message "A recirculation or return connection point on a Reactor must be an outlet carrying a fluid." ;
    ] ;
.

watr:SeparationTank a sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Separation Tank" ;
    rdfs:comment "A tank that has at least two outlets (e.g. overflow and underflow)" ;
    rdfs:subClassOf watr:Tank, watr:UnitProcess;
    # Separated solids are commonly returned to the head of the unit.
    watr:mayAlsoPerform watr:Process-Recirculation ;
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A separation tank has at least two outlet connection points" ;
        sh:qualifiedMinCount 2 ;
        sh:qualifiedValueShape [
            sh:class s223:OutletConnectionPoint ;
            sh:property [
                sh:path s223:hasMedium ;
                sh:class s223:Mix-Fluid ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Separation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of SeparationTank must have at least one Separation process." ;
    ] ;
.

watr:SequencingBatchReactor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "SequencingBatchReactor" ;
    rdfs:comment "A type of activated sludge process for wastewater treatment" ;
    rdfs:subClassOf watr:Reactor, watr:SeparationTank ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-ActivatedSludge ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of SequencingBatchReactor must have a ActivatedSludge process." ;
    ] ;
    # An SBR performs the solid-liquid separation phase in the same vessel.
    # State that step explicitly: Process-ActivatedSludge is a compound
    # biological process, not itself a subclass of Process-Separation.
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Sedimentation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of SequencingBatchReactor must have a Sedimentation process." ;
    ] ;
    # has 1 in, 1out (both water),  OR 1 bidirectional (water)
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A SBR has at least 1 sludge return point" ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class s223:OutletConnectionPoint ;
            sh:property [
                sh:path s223:hasMedium ;
                sh:class watr:Fluid-Sludge ;
            ] ;
        ] ;
    ] ;
    sh:xone (
        # 1 in (water) and 1 out (water)
        [ sh:property [
            sh:path s223:hasConnectionPoint ;
            rdfs:comment "A SBR has at least 1 inlet fluid connection point" ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [
                sh:class s223:InletConnectionPoint ;
                sh:property [
                    sh:path s223:hasMedium ;
                    sh:class s223:Mix-Fluid ;
                ] ;
            ] ;
        ] ;
        sh:property [
            sh:path s223:hasConnectionPoint ;
            rdfs:comment "A SBR has at least 1 outlet fluid connection point" ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [
                sh:class s223:OutletConnectionPoint ;
                sh:property [
                    sh:path s223:hasMedium ;
                    sh:class s223:Mix-Fluid ;
                ] ;
            ] ;
            
        ] ]
        # OR 1 bidirectional (water)
        [ sh:property [
            sh:path s223:hasConnectionPoint ;
            rdfs:comment "A SBR has at least 1 bidirectional fluid connection point" ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [
                sh:class s223:BidirectionalConnectionPoint ;
                sh:property [
                    sh:path s223:hasMedium ;
                    sh:class s223:Mix-Fluid ;
                ] ;
            ] ;
        ] ]
    ) .

watr:PlugFlowReactor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "PlugFlowReactor" ;
    rdfs:comment "A type of reactor where the fluid flows in one direction through the tube" ;
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A plug flow reactor has at least one inlet fluid connection point" ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class s223:InletConnectionPoint ;
            sh:property [
                sh:path s223:hasMedium ;
                sh:class s223:Mix-Fluid ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path s223:hasConnectionPoint ;
        rdfs:comment "A plug flow reactor has at least one outlet fluid connection point" ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class s223:OutletConnectionPoint ;
            sh:property [
                sh:path s223:hasMedium ;
                sh:class s223:Mix-Fluid ;
            ] ;
        ] ;
    ] ;
    rdfs:subClassOf watr:Reactor .

watr:ContinuouslyStirredTankReactor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "ContinuouslyStirredTankReactor" ;
    rdfs:comment "A reactor in which contents are well mixed and reactants are added continuously" ;
    rdfs:subClassOf watr:Reactor .

watr:StaticMixer
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "StaticMixer" ;
    rdfs:comment "A device for mixing liquids without moving components" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Mixing ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of StaticMixer must have a Mixing process." ;
    ] .

watr:AerationBasin
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Aeration Basin" ;
    rdfs:comment "A tank where water is aerated to remove gases and volatile organic compounds" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Aeration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of AerationBasin must have a Aeration process." ;
    ] ;
    sh:property [
        sh:path s223:hasRole ;
        # Qualified so the basin may also carry unrelated roles (Role-Primary,
        # Role-Detention, ...); a bare sh:in would have to hold for every value.
        sh:qualifiedValueShape [ sh:in ( watr:Role-Aerobic watr:Role-Anoxic ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of AerationBasin must have the aerobic or anoxic role." ;
    ] .

watr:MixingBasin
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Mixing Basin" ;
    rdfs:comment "A tank where mixed liquor is stirred without aeration" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Mixing ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MixingBasin must have a Mixing process." ;
    ] ;
    sh:property [
        sh:path s223:hasRole ;
        # Qualified for the same reason as AerationBasin above.
        sh:qualifiedValueShape [ sh:in ( watr:Role-Anoxic watr:Role-Anaerobic ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MixingBasin must have the anoxic or anaerobic role." ;
    ] .

watr:MembraneAeratedBiofilmReaactor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Membrane Aerated Biofilm Reactor" ;
    rdfs:comment "A reactor that grows biofilm on membranes supplied with air" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Aeration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MembraneAeratedBiofilmReactor must have a Aeration process." ;
    ] .
    
watr:CoagulationBasin
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Coagulation Basin" ;
    rdfs:comment "A basin where coagulation occurs to destabilize particles in water" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Coagulation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of CoagulationBasin must have a Coagulation process." ;
    ] .

watr:FlocculationBasin
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Flocculation Basin" ;
    rdfs:comment "A tank where flocculation occurs to aggregate particles in water" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Flocculation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of FlocculationBasin must have a Flocculation process." ;
    ] .

watr:Digester
    a  sh:NodeShape ;
    a watr:Class ;
    # Digesters draw off and handle biogas; mixing comes from watr:Reactor.
    watr:mayAlsoPerform watr:Process-GasTransfer ;
    rdfs:label "Digester" ;
    rdfs:comment "A container to promote decomposition of organic waste" ;
    rdfs:subClassOf watr:Reactor, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasOutcome ;
        sh:qualifiedValueShape [ sh:class watr:Outcome-Stabilization ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Digester must have the Stabilization outcome." ;
    ] ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Digestion ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Digester must have at least one Digestion process." ;
    ] .

watr:AnaerobicDigester
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Anaerobic Digester" ;
    rdfs:comment "A container to promote decomposition of organic waste in anaerobic conditions" ;
    rdfs:subClassOf watr:Digester ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-AnaerobicDigestion ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of AnaerobicDigester must have a AnaerobicDigestion process." ;
    ] .

watr:AerobicDigester
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Aerobic Digester" ;
    rdfs:comment "A container to promote decomposition of organic waste in aerobic conditions" ;
    rdfs:subClassOf watr:Digester ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-AerobicDigestion ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of AerobicDigester must have a AerobicDigestion process." ;
    ] .

watr:DisinfectionUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Disinfection Unit" ;
    rdfs:comment "A unit used to eliminate or reduce harmful microorganisms" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasOutcome ;
        sh:qualifiedValueShape [ sh:class watr:Outcome-Disinfection ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of DisinfectionUnit must have the Disinfection outcome." ;
    ] .

watr:ChlorinationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Chlorination Unit" ;
    rdfs:comment "A unit that uses chlorine or chlorine compounds for disinfection." ;
    rdfs:subClassOf watr:DisinfectionUnit ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Chlorination ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of ChlorinationUnit must have a Chlorination process." ;
    ] .

watr:UltravioletLightUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Ultravioletlight Unit" ;
    rdfs:comment "A unit using ultraviolet light for disinfection" ;
    rdfs:subClassOf watr:DisinfectionUnit ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-UVIrradiation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of UltravioletLightUnit must have a UVDisinfection process." ;
    ] .

watr:SedimentationTank
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Sedimentation Tank" ;
    rdfs:comment "A tank used to remove solids from liquids through sedimentation" ;
    rdfs:subClassOf watr:SeparationTank ;
    # Clarification is what the tank is for; sedimentation is what it does. The
    # same process serves a gravity thickener, whose objective is thickening, and
    # the role -- primary, secondary -- says which stage this one serves.
    sh:property [
        sh:path watr:hasOutcome ;
        sh:qualifiedValueShape [ sh:class watr:Outcome-Clarification ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of SedimentationTank must have the Clarification outcome." ;
    ] ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Sedimentation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of SedimentationTank must have a Sedimentation process." ;
    ] .

watr:SepticTank
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Septic Tank" ;
    rdfs:comment "A septic tank for on-site wastewater treatment" ;
    rdfs:subClassOf watr:SedimentationTank .

watr:ImhoffTank
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Imhoff Tank" ;
    rdfs:comment "A sedimentation tank specifically designed for septic treatment" ;
    rdfs:subClassOf watr:SepticTank .

watr:Screen
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Screen" ;
    rdfs:comment "An equipment used for separation" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Screening ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Screen must have a Screening process." ;
    ] .

watr:GritChamber
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Grit Chamber" ;
    rdfs:comment "A chamber used to remove grit from wastewater" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Sedimentation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of GritChamber must have a Sedimentation process." ;
    ] .

watr:Reservoir
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Reservoir" ;
    rdfs:comment "A large natural or artificial body of water used for water supply" ;
    rdfs:subClassOf s223:Equipment .

watr:Pond
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Pond" ;
    rdfs:comment "A body of still water smaller than a lake, used for treatment or storage." ;
    rdfs:subClassOf s223:Equipment .

watr:Wetland
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Wetland" ;
    rdfs:comment "A marsh or bog-like area that is permanently or seasonally saturated with water, used for pre- or post-treatment." ;
    rdfs:subClassOf s223:Equipment .

watr:Battery
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Battery" ;
    rdfs:comment "A device that stores energy for later use" ;
    rdfs:subClassOf s223:Battery .

watr:Cogenerator
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Cogenerator" ;
    rdfs:comment "An equipment that produces both electricity and heat from the same energy source" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Cogeneration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Cogenerator must have a Cogeneration process." ;
    ] .

watr:Boiler
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Boiler" ;
    rdfs:comment "A device for heating water" ;
    rdfs:subClassOf s223:Boiler, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Combustion ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Boiler must have a Combustion process." ;
    ] .

watr:Conditioner
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Conditioner" ;
    rdfs:comment "An equipment used to prepare raw biogas from a digester by removing impurities" ;
    rdfs:subClassOf s223:Equipment .

watr:Flare
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Flare" ;
    rdfs:comment "A device used to burn off unwanted gas" ;
    rdfs:subClassOf s223:Equipment .

watr:Pump
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Pump" ;
    rdfs:comment "A device used to move fluids by mechanical action" ;
    rdfs:subClassOf s223:Pump .

watr:PressureExchanger
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "PressureExchanger" ;
    rdfs:comment "A device used to transfer pressure energy from one fluid to another" ;
    rdfs:subClassOf s223:Equipment .

watr:DewateringUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Dewatering Unit" ;
    rdfs:comment "A unit used to remove water from solid material" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    # Dewatering is what the unit is for, so it sits on watr:hasOutcome. The
    # concrete subclasses state the process they reach it by -- filtration,
    # centrifugation -- on watr:hasProcess. The same processes serve thickening,
    # which is why the objective cannot be read off the mechanism.
    sh:property [
        sh:path watr:hasOutcome ;
        sh:qualifiedValueShape [ sh:class watr:Outcome-Dewatering ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of DewateringUnit must have the Dewatering outcome." ;
    ] .

watr:Thickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Thickener" ;
    rdfs:comment "A device used to increase the solids concentration of a slurry" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    # As with DewateringUnit, thickening is the objective and the subclasses
    # supply the process they thicken by.
    sh:property [
        sh:path watr:hasOutcome ;
        sh:qualifiedValueShape [ sh:class watr:Outcome-Thickening ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Thickener must have the Thickening outcome." ;
    ] .

watr:DissolvedAirFlotationThickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Dissolved Air Flotation Thickener" ;
    rdfs:comment "A thickener that uses dissolved air to separate solids from liquids" ;
    rdfs:subClassOf watr:Thickener;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Flotation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of DissolvedAirFlotationThickener must have a Flotation process." ;
    ] .

watr:CentrifugalThickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Centrifugal Thickener" ;
    rdfs:comment "A thickener that uses centrifugal force to separate solids from liquids" ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Centrifugation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of CentrifugalThickener must have a Centrifugation process." ;
    ] .

watr:GravityThickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Gravity Thickener" ;
    rdfs:comment "A thickener that uses gravity to separate solids from liquids" ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Sedimentation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of GravityThickener must have a Sedimentation process." ;
    ] .

watr:BeltThickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Belt Thickener" ;
    rdfs:comment "A thickener that uses a belt system to separate solids from liquids" ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of BeltThickener must have a Filtration process." ;
    ] .

watr:GravityBeltThickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Gravity Belt Thickener" ;
    rdfs:comment "A belt thickener in which gravity drains water through a porous moving belt. It uses filtration rather than the sedimentation mechanism of a conventional gravity thickener." ;
    rdfs:subClassOf watr:BeltThickener .

watr:RotaryDrumThickener
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Rotary Drum Thickener" ;
    rdfs:comment "A thickener that uses a rotating drum to separate solids from liquids" ;
    rdfs:subClassOf watr:Thickener ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of RotaryDrumThickener must have a Filtration process." ;
    ] .

watr:BeltFilterPress
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Belt Filter Press" ;
    rdfs:comment "A dewatering unit that uses a belt system to separate solids from liquids" ;
    rdfs:subClassOf watr:DewateringUnit ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of BeltFilterPress must have a Filtration process." ;
    ] .

watr:CentrifugalDewateringUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Centrifugal Dewatering Unit" ;
    rdfs:comment "A dewatering unit that uses centrifugal force to separate solids from liquids" ;
    rdfs:subClassOf watr:DewateringUnit ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Centrifugation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of CentrifugalDewateringUnit must have a Centrifugation process." ;
    ] .

watr:Filter
    a  sh:NodeShape ;
    a watr:Class ;
    # Backwashing, air scouring and purging are routine filter operations rather
    # than treatment steps, so they are permitted on every filter subclass.
    watr:mayAlsoPerform watr:Process-Cleaning ;
    rdfs:label "Filter" ;
    rdfs:comment "An equipment used to remove impurities from liquids or gases" ;
    rdfs:subClassOf s223:Filter, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Filtration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Filter must have at least one Filtration process." ;
    ] .

watr:ReverseOsmosisMembrane
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Reverse Osmosis Membrane" ;
    rdfs:comment "A membrane used for reverse osmosis" ;
    rdfs:subClassOf watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-ReverseOsmosis ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of ReverseOsmosisMembrane must have a ReverseOsmosis process." ;
    ] .

watr:RotatingBiologicalContactor 
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Rotating Biological Contactor (RBC)" ;
    rdfs:comment "Fixed-film process using a slowly rotating discs partially submerged in a tank" ;
    # Both a Reactor and a Filter, like watr:MovingBedBioreactor: the discs turn
    # in a tank, and the rotation is what aerates the biofilm as it lifts clear
    # of the liquid. The Reactor parent is what permits declaring that aeration.
    rdfs:subClassOf watr:Reactor, watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Biofiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of RotatingBiologicalContactor must have a Biofiltration process." ;
    ] .

watr:MovingBedBioreactor 
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Moving Bed Bioreactor (MBBR)" ;
    rdfs:comment "MBBR process using suspended growth media a tank" ;
    # Both a Reactor and a Filter: an MBBR is a tank of suspended biofilm
    # carriers. The Reactor parent is what permits it to declare the aeration
    # that supplies oxygen and keeps the carriers circulating.
    rdfs:subClassOf watr:Reactor, watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Biofiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MovingBedBioreactor must have a Biofiltration process." ;
    ] .

watr:TricklingFilter
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Trickling Filter" ;
    rdfs:comment "A filter system that treats wastewater by trickling it over a bed of rocks or plastic" ;
    rdfs:subClassOf watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-TricklingFiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of TricklingFilter must have a TricklingFiltration process." ;
    ] .

watr:OxidationDitch
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Oxidation Ditch" ;
    rdfs:comment "Modified activated sludge process that uses a ring-shaped channel to biologically remove pollutants" ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-ActivatedSludge ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of OxidationDitch must have a ActivatedSludge process." ;
    ] .

watr:MembraneBioreactor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Membrane Bioreactor" ;
    rdfs:comment "A filter system that combines a membrane process like microfiltration with a biological reactor" ;
    rdfs:subClassOf watr:Filter, watr:Reactor, watr:SeparationTank ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:in ( watr:Process-Microfiltration watr:Process-Ultrafiltration ) ];
        sh:qualifiedMinCount 1 ;
		sh:qualifiedMaxCount 1 ;
        sh:message "Instances of MembraneBioreactor must have either the Microfiltration or Ultrafiltration process." ;
    ] ;
    sh:property [
        sh:path watr:hasProcess ;
        # Qualified (not sh:class + sh:minCount) because MembraneBioreactor
        # requires two different processes on watr:hasProcess: a bare sh:class
        # would have to hold for *every* value, rejecting the MF/UF one above.
        sh:qualifiedValueShape [ sh:class watr:Process-Biofiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MembraneBioreactor must have a Biofiltration process." ;
    ] .
    
watr:MicrofiltrationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Microfiltration Unit" ;
    rdfs:comment "A filter system which removes contaminants from a liquid by passing it through a microporous membrane" ;
    rdfs:subClassOf watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Microfiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MicrofiltrationUnit must have a Microfiltration process." ;
    ] .

watr:UltrafiltrationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Ultrafiltration Unit" ;
    rdfs:comment "A filter system that uses a pressure-driven barrier to separate particles and solutes in a fluid" ;
    rdfs:subClassOf watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Ultrafiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of UltrafiltrationUnit must have a Ultrafiltration process." ;
    ] .

watr:NanofiltrationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Nanofiltration Unit" ;
    rdfs:comment "A filter system that uses a membrane to soften water and remove organic contaminants" ;
    rdfs:subClassOf watr:Filter .

watr:MediaFiltrationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "MediaFiltration Unit" ;
    rdfs:comment "A filter system that uses a bed of material to filter out contaminants" ;
    rdfs:subClassOf watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-MediaFiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of MediaFiltrationUnit must have at least one MediaFiltration process." ;
    ] .

watr:RapidSandFilter
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Rapid Sand Filter" ;
    rdfs:comment "A type of media filter that uses sand as the filter medium and operates at high filtration rates." ;
    rdfs:subClassOf watr:MediaFiltrationUnit ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-RapidSandFiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of RapidSandFilter must have a RapidSandFiltration process." ;
    ] .

watr:CartridgeFiltrationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Cartridge Filtration Unit" ;
    rdfs:comment "A filter system using a cartridge to remove contaminants from fluids" ;
    rdfs:subClassOf watr:Filter .
    
watr:IonExchangeMembrane
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Ion Exchange Membrane" ;
    rdfs:comment "A membrane that selectively allows ions to pass through while blocking other substances" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-IonExchange ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of IonExchangeMembrane must have a IonExchange process." ;
    ] .

watr:ElectrodialysisUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electrodialysis" ;
    rdfs:comment "A unit that uses electricity to drive ion movement through a membrane" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Electrodialysis ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of ElectrodialysisUnit must have a Electrodialysis process." ;
    ] .

watr:Electrolyzer
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electrolyzer" ;
    rdfs:comment "An equipment that uses electricity to split liquids into constituent elements" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Electrolysis ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Electrolyzer must have a Electrolysis process." ;
    ] .

watr:Crystallizer
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Crystallizer" ;
    rdfs:comment "An equipment used to produce solid crystals from a solution" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Crystallization ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Crystallizer must have a Crystallization process." ;
    ] .

watr:Compressor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Compressor" ;
    rdfs:comment "An equipment that increases the pressure of a gas" ;
    rdfs:subClassOf s223:Compressor .

watr:Evaporator
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Evaporator" ;
    rdfs:comment "A device used to turn the liquid form of a substance into its gaseous form" ;
    rdfs:subClassOf s223:HeatExchanger, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Evaporation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Evaporator must have a Evaporation process." ;
    ] .

watr:Condenser
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Condenser" ;
    rdfs:comment "A device used to condense a gaseous substance back into a liquid" ;
    rdfs:subClassOf s223:HeatExchanger, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Condensation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of Condenser must have a Condensation process." ;
    ] .

watr:FlowSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Flow Sensor" ;
    rdfs:comment "A sensor used to measure the flow rate of liquids or gases" ;
    rdfs:subClassOf s223:FlowSensor .

watr:VolumeSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Volume Sensor" ;
    rdfs:comment "A sensor used to measure the volume of a substance" ;
    rdfs:subClassOf s223:Sensor .

watr:LevelSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Level Sensor" ;
    rdfs:comment "A sensor used to detect the level of liquids or solids in a tank" ;
    rdfs:subClassOf s223:Sensor .

watr:PressureSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Pressure Sensor" ;
    rdfs:comment "A sensor used to measure pressure" ;
    rdfs:subClassOf s223:PressureSensor .

watr:TemperatureSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Temperature Sensor" ;
    rdfs:comment "A sensor used to measure temperature" ;
    rdfs:subClassOf s223:TemperatureSensor .

watr:ConcentrationSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Concentration Sensor" ;
    rdfs:comment "A sensor used to measure the concentration of specific substances (e.g., Total Dissolved Solids)" ;
    rdfs:subClassOf s223:ConcentrationSensor .

watr:OxygenMeter
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Oxygen Meter" ;
    rdfs:comment "A sensor used to measure the concentration of oxygen" ;
    rdfs:subClassOf s223:ConcentrationSensor .

watr:OxygenDemandSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "OxygenDemand Sensor" ;
    rdfs:comment "A sensor used to measure Chemical Oxygen Demand (COD) and Biological Oxygen Demand (BOD)" ;
    rdfs:subClassOf s223:Sensor .

watr:pHSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "pH Sensor" ;
    rdfs:comment "A sensor used to measure the pH of a solution" ;
    rdfs:subClassOf watr:ConcentrationSensor .

watr:ConductivitySensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Conductivity Sensor" ;
    rdfs:comment "A sensor used to measure the electrical conductivity of a solution" ;
    rdfs:subClassOf s223:Sensor .

watr:TurbidityMeter
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Turbidity Meter" ;
    rdfs:comment "A sensor used to measure the turbidity (clarity) of a fluid" ;
    rdfs:subClassOf s223:Sensor .

watr:RotationSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Rotation Sensor" ;
    rdfs:comment "A sensor used to measure the rotational speed or position of an object" ;
    rdfs:subClassOf s223:Sensor .

watr:EfficiencySensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Efficiency Sensor" ;
    rdfs:comment "A sensor used to measure the efficiency of a system or equipment" ;
    rdfs:subClassOf s223:Sensor .

watr:StateOfChargeSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "State of Charge Sensor" ;
    rdfs:comment "A sensor used to measure the remaining charge in a battery or energy storage system" ;
    rdfs:subClassOf s223:Sensor .

watr:SpeedSensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Speed Sensor" ;
    rdfs:comment "A sensor used to measure the speed of an object or fluid" ;
    rdfs:subClassOf s223:Sensor .

watr:FrequencySensor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Frequency Sensor" ;
    rdfs:comment "A sensor used to measure the frequency of a signal or mechanical vibration" ;
    rdfs:subClassOf s223:Sensor .

# Do we want something like this? Is modeling a TOC sensor without explicitly naming it too vague (Concentration sensor, measuring organics)
watr:TotalOrganicCompoundConcentrationSensor
    a watr:Class, sh:NodeShape ;
    a watr:Class ;
    rdfs:label "TOC Sensor" ;
    rdfs:comment "A sensor used to measure the total organic compound concentration" ;
    rdfs:subClassOf watr:ConcentrationSensor .

watr:Valve 
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A device that regulates, directs or controls the flow of a fluid (gases or liquids) by opening, closing, or partially obstructing various passageways." ;
    rdfs:label "Valve" ;
    rdfs:subClassOf s223:Valve 
.

watr:VariableFrequencyDrive
    a s223:Class, sh:NodeShape ;
    a watr:Class ;
    rdfs:comment "A type of AC motor drive that controls speed and torque by varying the frequency of the input electricity." ;
    rdfs:subClassOf s223:VariableFrequencyDrive ;
    rdfs:label "Variable Frequency Drive" 
.

watr:ThreeWayValve 
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A valve that features three ports (connections)" ;
    rdfs:label "Three Way Valve" ;
    rdfs:subClassOf s223:Valve 
.

watr:CheckValve
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A valve that normally allows fluid (liquid or gas) to flow through it in only one direction" ;
    rdfs:label "Check Valve" ;
    rdfs:subClassOf s223:Valve
.

watr:BallValve
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A valve which operates using a spherical ball with a hole (also known as a bore) through the middle." ;
    rdfs:label "Ball Valve" ;
    rdfs:subClassOf s223:Valve
.

watr:ButterflyValve
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A quarter-turn rotary valve used to isolate, start, stop, or regulate the flow of fluids" ;
    rdfs:label "Butterfly Valve" ;
    rdfs:subClassOf s223:Valve
.

watr:GlobeValve
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A linear-motion valve primarily used for stopping, starting, and regulating (throttling) fluid flow" ;
    rdfs:label "Globe Valve" ;
    rdfs:subClassOf s223:Valve
.

watr:PlugValve
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:comment "A valve with cylindrical or conically tapered plugs which can be rotated inside the valve body to control flow through the valve" ;
    rdfs:label "Plug Valve" ;
    rdfs:subClassOf s223:Valve
.

watr:AirReleaseValve
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:label "Air Release Valve" ;
    rdfs:comment "Valve for vent trapped air pockets" ;
    rdfs:subClassOf s223:Valve
.

watr:Controller 
    a s223:Class, sh:NodeShape ;
    a watr:Class ;
    rdfs:comment "A piece of equipment for regulation of a system or component in normal operation, which executes one or more `Function`s." ;
    rdfs:label "Controller" ;
    rdfs:subClassOf s223:Controller .

watr:ManualMeasurementPort 
    a watr:Class, sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Manual Measurement Port" ;
    rdfs:comment "A location where manual measurements are taken" ;
    rdfs:subClassOf s223:Sensor .

watr:MultifunctionalMembrane
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Multifunctional Membrane" ;
    rdfs:comment "A membrane integrating multiple processes (e.g., reduction, adsorption, filtration) for selective removal and recovery of contaminants." ;
    rdfs:subClassOf watr:Filter .

watr:MolybdenumSulfideBasedMembrane
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Molybdenum Sulfide (MoS2)-based Membrane" ;
    rdfs:comment "A specific material demonstrating effectiveness in removing heavy metals and oxyanions with high selectivity." ;
    rdfs:subClassOf watr:Filter .

watr:ElectricallyConductingMembrane
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electrically Conducting Membrane" ;
    rdfs:comment "A membrane capable of conducting electricity, used for in-situ cleaning or electro-oxidation processes." ;
    rdfs:subClassOf watr:Filter .

watr:ElectroDialyticCrystallizer
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electro-Dialytic Crystallizer (EDC)" ;
    rdfs:comment "A modular system designed for brine concentration and crystallization, integrating electrodialysis and crystallization." ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess  ;
    # Two required processes. Process-ElectroDialyticCrystallization is an
    # rdfs:subClassOf both, so a single value of that type satisfies both slots;
    # an instance may equally carry a separate electrodialysis and
    # crystallization process.
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Electrodialysis ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of ElectroDialyticCrystallizer must have a Electrodialysis process." ;
    ] ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Crystallization ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of ElectroDialyticCrystallizer must have a Crystallization process." ;
    ] .

watr:Electrode
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electrode" ;
    rdfs:comment "A component where electrochemical reactions occur in electrified processes." ;
    rdfs:subClassOf s223:Equipment .

watr:Anode
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Anode" ;
    rdfs:comment "An electrode where oxidation occurs, often a sacrificial component in electrocoagulation." ;
    rdfs:subClassOf watr:Electrode .

watr:Cathode
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Cathode" ;
    rdfs:comment "An electrode where reduction occurs." ;
    rdfs:subClassOf watr:Electrode .

watr:ElectromagneticFieldDevice
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electromagnetic Field (EMF) Device" ;
    rdfs:comment "A device that generates an electromagnetic field, used as a pretreatment method for membrane scaling and fouling control." ;
    rdfs:subClassOf s223:Equipment .

watr:SolventExtractionSystem
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Solvent Extraction System" ;
    rdfs:comment "A system that uses a solvent to selectively extract water from highly saline brines." ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-SolventExtraction ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of SolventExtractionSystem must have a SolventExtraction process." ;
    ] .

watr:DMERecoverySystem
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Dimethyl Ether (DME) Recovery System" ;
    rdfs:comment "A system designed to recover a high percentage of Dimethyl Ether solvent in solvent-driven processes." ;
    rdfs:subClassOf s223:Equipment .

watr:StandardizedFlowCell
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Standardized Flow Cell" ;
    rdfs:comment "An experimental apparatus developed for research experiments, for example in Electrocoagulation (EC), in continuous flow mode." ;
    rdfs:subClassOf s223:Equipment .

watr:UVH2O2Reactor
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "UV/H2O2 Reactor" ;
    rdfs:comment "A specific reactor used in Advanced Oxidation Processes (AOPs) combining UV light with hydrogen peroxide." ;
    rdfs:subClassOf watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-AdvancedOxidation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of UVH2O2Reactor must have a AdvancedOxidation process." ;
    ] .

watr:BiologicalAeratedFilter
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Biological Aerated Filter (BAF)" ;
    rdfs:comment "A filter that uses biological processes to remove contaminants." ;
    rdfs:subClassOf watr:Reactor, watr:Filter ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-BiologicallyActiveFiltration ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of BiologicalAeratedFilter must have a BiologicallyActiveFiltration process." ;
    ] .

watr:ElectrocoagulationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Electrocoagulation Unit" ;
    rdfs:comment "A unit that uses electrocoagulation for contaminant removal." ;
    rdfs:subClassOf s223:Equipment, watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Electrocoagulation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of ElectrocoagulationUnit must have a Electrocoagulation process." ;
    ] .

watr:OzonationUnit
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Ozonation Unit" ;
    rdfs:comment "A unit that uses ozone for water treatment." ;
    rdfs:subClassOf s223:Equipment, watr:Reactor ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Ozonation ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of OzonationUnit must have a Ozonation process." ;
    ] .

watr:GranularActivatedCarbonAdsorber
    a  sh:NodeShape ;
    a watr:Class ;
    rdfs:label "Granular Activated Carbon (GAC) Adsorber" ;
    rdfs:comment "A unit that uses granulated activated carbon to adsorb impurities from water." ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-GranularActivatedCarbon ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Instances of GranulatedActivatedCarbonAdsorber must have a GranularActivatedCarbon process." ;
    ] .

watr:Grinder
    a  sh:NodeShape ;
    a watr:Class ; 
    rdfs:label "Grinder" ;
    rdfs:comment "Machine that shreds solid waste into tiny particles" ;
    rdfs:subClassOf s223:Equipment, watr:UnitProcess ;
    sh:property [
        sh:path watr:hasProcess ;
        sh:qualifiedValueShape [ sh:class watr:Process-Comminution ] ;
        sh:qualifiedMinCount 1 ;
		sh:qualifiedMaxCount 1 ;
        sh:message "Instances of Grinder must have the Comminution process." ;
    ] 
.

watr:Gate 
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:label "Gate" ;
    rdfs:comment "Tool to control water flow and isolate sections" ;
    rdfs:subClassOf s223:Valve 
.

watr:SluiceGate
    a s223:Class, sh:NodeShape; 
    a watr:Class ;
    rdfs:label "Sluice Gate" ;
    rdfs:comment "Large gate that slide vertically to control flow in channels, reservoirs, or treatment basins" ;
    rdfs:subClassOf watr:Gate 
.
