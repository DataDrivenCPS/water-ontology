@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix equip: <urn:nawi-water-ontology/equip#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology/enumerationkinds>
    a owl:Ontology ;
    rdfs:label "NAWI Water EnumerationKinds Ontology" ;
    rdfs:comment "An ontology for enumerationkinds used in the NAWI project" ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
.
watr:EnumerationKind-DataProcessing 
    a watr:Class ;
    # Is this an intentional modeling pattern? 
    a s223:EnumerationKind-DataQuality ;
    a sh:NodeShape ;
    rdfs:label "DataQuality" ;
    rdfs:comment "This EnumerationKind describes methods of data processing, aggregation, or imputation" ;
    rdfs:subClassOf s223:EnumerationKind ;
.
watr:DataProcessing-Filter 
    a watr:Class ;
    a watr:DataProcessing-Filter ;
    a sh:NodeShape ;
    rdfs:label "Filter" ;
    rdfs:comment "Parent class for filtering methods to remove outliers or unwanted data points" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:DataProcessing-Aggregate
    a watr:Class ;
    a watr:DataProcessing-Aggregate ;
    a sh:NodeShape ;
    rdfs:label "Aggregate" ;
    rdfs:comment "Parent class for aggregation functions that combine multiple data points" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Aggregate-Mean
    a watr:Class ;
    a watr:Aggregate-Mean ;
    a sh:NodeShape ;
    rdfs:label "Mean" ;
    rdfs:comment "Arithmetic mean (average) of data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Median
    a watr:Class ;
    a watr:Aggregate-Median ;
    a sh:NodeShape ;
    rdfs:label "Median" ;
    rdfs:comment "Middle value of sorted data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Max
    a watr:Class ;
    a watr:Aggregate-Max ;
    a sh:NodeShape ;
    rdfs:label "Maximum" ;
    rdfs:comment "Maximum value from data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Min
    a watr:Class ;
    a watr:Aggregate-Min ;
    a sh:NodeShape ;
    rdfs:label "Minimum" ;
    rdfs:comment "Minimum value from data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Sum
    a watr:Class ;
    a watr:Aggregate-Sum ;
    a sh:NodeShape ;
    rdfs:label "Sum" ;
    rdfs:comment "Sum of all data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Count
    a watr:Class ;
    a watr:Aggregate-Count ;
    a sh:NodeShape ;
    rdfs:label "Count" ;
    rdfs:comment "Count of data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-StdDev
    a watr:Class ;
    a watr:Aggregate-StdDev ;
    a sh:NodeShape ;
    rdfs:label "Standard Deviation" ;
    rdfs:comment "Standard deviation of data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Variance
    a watr:Class ;
    a watr:Aggregate-Variance ;
    a sh:NodeShape ;
    rdfs:label "Variance" ;
    rdfs:comment "Variance of data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Range
    a watr:Class ;
    a watr:Aggregate-Range ;
    a sh:NodeShape ;
    rdfs:label "Range" ;
    rdfs:comment "Difference between maximum and minimum values" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.
watr:Aggregate-Mode
    a watr:Class ;
    a watr:Aggregate-Mode ;
    a sh:NodeShape ;
    rdfs:label "Mode" ;
    rdfs:comment "Most frequently occurring value in data points" ;
    rdfs:subClassOf watr:DataProcessing-Aggregate ;
.

watr:EnumerationKind-Aggregation
    a watr:Class ;
    a watr:EnumerationKind-Aggregation ;
    a sh:NodeShape ;
    rdfs:label "Aggregation" ;
    rdfs:comment "EnumerationKind for aggregation semantics carried by a property, such as total, mean, maximum, or minimum." ;
    rdfs:subClassOf s223:EnumerationKind-Aspect ;
.

watr:Aggregation-Total
    a watr:Class ;
    a watr:Aggregation-Total ;
    a sh:NodeShape ;
    owl:equivalentClass s223:Aspect-Total ;
    rdfs:label "Total" ;
    rdfs:comment "The associated property represents the total amount of the characterized quantity or substance." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Max
    a watr:Class ;
    a watr:Aggregation-Max ;
    a sh:NodeShape ;
    rdfs:label "Maximum" ;
    rdfs:comment "The associated property represents the maximum value over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Min
    a watr:Class ;
    a watr:Aggregation-Min ;
    a sh:NodeShape ;
    rdfs:label "Minimum" ;
    rdfs:comment "The associated property represents the minimum value over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Mean
    a watr:Class ;
    a watr:Aggregation-Mean ;
    a sh:NodeShape ;
    rdfs:label "Mean" ;
    rdfs:comment "The associated property represents the arithmetic mean over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Median
    a watr:Class ;
    a watr:Aggregation-Median ;
    a sh:NodeShape ;
    rdfs:label "Median" ;
    rdfs:comment "The associated property represents the median value over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Percentile
    a watr:Class ;
    a watr:Aggregation-Percentile ;
    a sh:NodeShape ;
    rdfs:label "Percentile" ;
    rdfs:comment "The associated property represents the percentile value over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Sum
    a watr:Class ;
    a watr:Aggregation-Sum ;
    a sh:NodeShape ;
    rdfs:label "Sum" ;
    rdfs:comment "The associated property represents the sum over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Count
    a watr:Class ;
    a watr:Aggregation-Count ;
    a sh:NodeShape ;
    rdfs:label "Count" ;
    rdfs:comment "The associated property represents a count over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Range
    a watr:Class ;
    a watr:Aggregation-Range ;
    a sh:NodeShape ;
    rdfs:label "Range" ;
    rdfs:comment "The associated property represents the difference between maximum and minimum over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Mode
    a watr:Class ;
    a watr:Aggregation-Mode ;
    a sh:NodeShape ;
    rdfs:label "Mode" ;
    rdfs:comment "The associated property represents the most frequently occurring value over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-Variance
    a watr:Class ;
    a watr:Aggregation-Variance ;
    a sh:NodeShape ;
    rdfs:label "Variance" ;
    rdfs:comment "The associated property represents the variance over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.

watr:Aggregation-StandardDeviation
    a watr:Class ;
    a watr:Aggregation-StandardDeviation ;
    a sh:NodeShape ;
    rdfs:label "Standard Deviation" ;
    rdfs:comment "The associated property represents the standard deviation over an aggregation scope." ;
    rdfs:subClassOf watr:EnumerationKind-Aggregation ;
.
watr:DataProcessing-Interpolation
    a watr:Class ;
    a watr:DataProcessing-Interpolation ;
    a sh:NodeShape ;
    rdfs:label "Interpolation" ;
    rdfs:comment "Parent class for interpolation methods to estimate values between known data points" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Interpolation-Linear
    a watr:Class ;
    a watr:Interpolation-Linear ;
    a sh:NodeShape ;
    rdfs:label "Linear Interpolation" ;
    rdfs:comment "Linear interpolation between two adjacent data points" ;
    rdfs:subClassOf watr:DataProcessing-Interpolation ;
.
watr:Interpolation-Spline
    a watr:Class ;
    a watr:Interpolation-Spline ;
    a sh:NodeShape ;
    rdfs:label "Spline Interpolation" ;
    rdfs:comment "Cubic spline interpolation for smooth curves" ;
    rdfs:subClassOf watr:DataProcessing-Interpolation ;
.
watr:Interpolation-Polynomial
    a watr:Class ;
    a watr:Interpolation-Polynomial ;
    a sh:NodeShape ;
    rdfs:label "Polynomial Interpolation" ;
    rdfs:comment "Polynomial interpolation using multiple data points" ;
    rdfs:subClassOf watr:DataProcessing-Interpolation ;
.
watr:Interpolation-NearestNeighbor
    a watr:Class ;
    a watr:Interpolation-NearestNeighbor ;
    a sh:NodeShape ;
    rdfs:label "Nearest Neighbor" ;
    rdfs:comment "Use the value of the nearest known data point" ;
    rdfs:subClassOf watr:DataProcessing-Interpolation ;
.
watr:Interpolation-ForwardFill
    a watr:Class ;
    a watr:Interpolation-ForwardFill ;
    a sh:NodeShape ;
    rdfs:label "Forward Fill" ;
    rdfs:comment "Propagate last valid observation forward to fill gaps" ;
    rdfs:subClassOf watr:DataProcessing-Interpolation ;
.
watr:Interpolation-BackwardFill
    a watr:Class ;
    a watr:Interpolation-BackwardFill ;
    a sh:NodeShape ;
    rdfs:label "Backward Fill" ;
    rdfs:comment "Propagate next valid observation backward to fill gaps" ;
    rdfs:subClassOf watr:DataProcessing-Interpolation ;
.
watr:DataProcessing-Normalization
    a watr:Class ;
    a watr:DataProcessing-Normalization ;
    a sh:NodeShape ;
    rdfs:label "Normalization" ;
    rdfs:comment "Parent class for normalization methods to scale data to a standard range" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Normalization-MinMax
    a watr:Class ;
    a watr:Normalization-MinMax ;
    a sh:NodeShape ;
    rdfs:label "Min-Max Normalization" ;
    rdfs:comment "Scale data to a fixed range, typically [0, 1]" ;
    rdfs:subClassOf watr:DataProcessing-Normalization ;
.
watr:Normalization-ZScore
    a watr:Class ;
    a watr:Normalization-ZScore ;
    a sh:NodeShape ;
    rdfs:label "Z-Score Normalization" ;
    rdfs:comment "Standardize data to have mean=0 and standard deviation=1" ;
    rdfs:subClassOf watr:DataProcessing-Normalization ;
.
watr:Normalization-Decimal
    a watr:Class ;
    a watr:Normalization-Decimal ;
    a sh:NodeShape ;
    rdfs:label "Decimal Scaling" ;
    rdfs:comment "Normalize by moving the decimal point of values" ;
    rdfs:subClassOf watr:DataProcessing-Normalization ;
.
watr:DataProcessing-Synchronization
    a watr:Class ;
    a watr:DataProcessing-Synchronization ;
    a sh:NodeShape ;
    rdfs:label "Synchronization" ;
    rdfs:comment "Parent class for synchronization methods to align data from multiple sources to common time intervals" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Synchronization-Resampling
    a watr:Class ;
    a watr:Synchronization-Resampling ;
    a sh:NodeShape ;
    rdfs:label "Resampling" ;
    rdfs:comment "Resample data to a different frequency or time interval" ;
    rdfs:subClassOf watr:DataProcessing-Synchronization ;
.
watr:Synchronization-Upsampling
    a watr:Class ;
    a watr:Synchronization-Upsampling ;
    a sh:NodeShape ;
    rdfs:label "Upsampling" ;
    rdfs:comment "Increase the sampling frequency of data to a higher rate" ;
    rdfs:subClassOf watr:DataProcessing-Synchronization ;
.
watr:Synchronization-Downsampling
    a watr:Class ;
    a watr:Synchronization-Downsampling ;
    a sh:NodeShape ;
    rdfs:label "Downsampling" ;
    rdfs:comment "Decrease the sampling frequency of data to a lower rate" ;
    rdfs:subClassOf watr:DataProcessing-Synchronization ;
.
watr:Synchronization-TimeAlignment
    a watr:Class ;
    a watr:Synchronization-TimeAlignment ;
    a sh:NodeShape ;
    rdfs:label "Time Alignment" ;
    rdfs:comment "Align data points from different sources to common timestamps" ;
    rdfs:subClassOf watr:DataProcessing-Synchronization ;
.
watr:DataProcessing-ErrorMetrics
    a watr:Class ;
    a watr:DataProcessing-ErrorMetrics ;
    a sh:NodeShape ;
    rdfs:label "Error Metrics" ;
    rdfs:comment "Parent class for error and uncertainty measurements" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Error-AbsoluteError
    a watr:Class ;
    a watr:Error-AbsoluteError ;
    a sh:NodeShape ;
    rdfs:label "Absolute Error" ;
    rdfs:comment "Absolute difference between measured and true/reference value" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:Error-RelativeError
    a watr:Class ;
    a watr:Error-RelativeError ;
    a sh:NodeShape ;
    rdfs:label "Relative Error" ;
    rdfs:comment "Error expressed as a percentage of the true/reference value" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:Error-MeanAbsoluteError
    a watr:Class ;
    a watr:Error-MeanAbsoluteError ;
    a sh:NodeShape ;
    rdfs:label "Mean Absolute Error (MAE)" ;
    rdfs:comment "Average of absolute errors across multiple measurements" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:Error-MeanSquaredError
    a watr:Class ;
    a watr:Error-MeanSquaredError ;
    a sh:NodeShape ;
    rdfs:label "Mean Squared Error (MSE)" ;
    rdfs:comment "Average of squared errors" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:Error-RootMeanSquaredError
    a watr:Class ;
    a watr:Error-RootMeanSquaredError ;
    a sh:NodeShape ;
    rdfs:label "Root Mean Squared Error (RMSE)" ;
    rdfs:comment "Square root of MSE, in same units as measurements" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:Error-MeanAbsolutePercentageError
    a watr:Class ;
    a watr:Error-MeanAbsolutePercentageError ;
    a sh:NodeShape ;
    rdfs:label "Mean Absolute Percentage Error (MAPE)" ;
    rdfs:comment "Average of absolute percentage errors" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:Error-Bias
    a watr:Class ;
    a watr:Error-Bias ;
    a sh:NodeShape ;
    rdfs:label "Bias" ;
    rdfs:comment "Systematic deviation from true value (trueness measure)" ;
    rdfs:subClassOf watr:DataProcessing-ErrorMetrics ;
.
watr:DataProcessing-PrecisionMetrics
    a watr:Class ;
    a watr:DataProcessing-PrecisionMetrics ;
    a sh:NodeShape ;
    rdfs:label "Precision Metrics" ;
    rdfs:comment "Metrics for precision and repeatability measurements" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Precision-RepeatabilityStdDev
    a watr:Class ;
    a watr:Precision-RepeatabilityStdDev ;
    a sh:NodeShape ;
    rdfs:label "Repeatability Standard Deviation" ;
    rdfs:comment "Standard deviation under repeatability conditions (same operator, equipment, short time)" ;
    rdfs:subClassOf watr:DataProcessing-PrecisionMetrics ;
.
watr:Precision-ReproducibilityStdDev
    a watr:Class ;
    a watr:Precision-ReproducibilityStdDev ;
    a sh:NodeShape ;
    rdfs:label "Reproducibility Standard Deviation" ;
    rdfs:comment "Standard deviation under reproducibility conditions (different operators, equipment, time)" ;
    rdfs:subClassOf watr:DataProcessing-PrecisionMetrics ;
.
watr:Precision-CoefficientOfVariation
    a watr:Class ;
    a watr:Precision-CoefficientOfVariation ;
    a sh:NodeShape ;
    rdfs:label "Coefficient of Variation" ;
    rdfs:comment "Ratio of standard deviation to mean (relative precision)" ;
    rdfs:subClassOf watr:DataProcessing-PrecisionMetrics ;
.
watr:Precision-ConfidenceInterval
    a watr:Class ;
    a watr:Precision-ConfidenceInterval ;
    a sh:NodeShape ;
    rdfs:label "Confidence Interval" ;
    rdfs:comment "Range within which true value likely falls with specified confidence level" ;
    rdfs:subClassOf watr:DataProcessing-PrecisionMetrics ;
.
watr:DataProcessing-AccuracyMetrics
    a watr:Class ;
    a watr:DataProcessing-AccuracyMetrics ;
    a sh:NodeShape ;
    rdfs:label "Accuracy Metrics" ;
    rdfs:comment "Combined accuracy measures (precision and trueness)" ;
    rdfs:subClassOf s223:EnumerationKind-DataProcessing ;
.
watr:Accuracy-TotalUncertainty
    a watr:Class ;
    a watr:Accuracy-TotalUncertainty ;
    a sh:NodeShape ;
    rdfs:label "Total Uncertainty" ;
    rdfs:comment "Combined standard uncertainty from all sources" ;
    rdfs:subClassOf watr:DataProcessing-AccuracyMetrics ;
.
watr:Accuracy-ExpandedUncertainty
    a watr:Class ;
    a watr:Accuracy-ExpandedUncertainty ;
    a sh:NodeShape ;
    rdfs:label "Expanded Uncertainty" ;
    rdfs:comment "Total uncertainty multiplied by coverage factor" ;
    rdfs:subClassOf watr:DataProcessing-AccuracyMetrics ;
.
watr:Accuracy-PercentRecovery
    a watr:Class ;
    a watr:Accuracy-PercentRecovery ;
    a sh:NodeShape ;
    rdfs:label "Percent Recovery" ;
    rdfs:comment "Ratio of measured to known value (for spike/recovery tests)" ;
    rdfs:subClassOf watr:DataProcessing-AccuracyMetrics ;
.
watr:Accuracy-RSquared
    a watr:Class ;
    a watr:Accuracy-RSquared ;
    a sh:NodeShape ;
    rdfs:label "R-Squared" ;
    rdfs:comment "Coefficient of determination for calibration curves" ;
    rdfs:subClassOf watr:DataProcessing-AccuracyMetrics ;
.

# Roles describe how an entity can serve within a system. WaTr defines treatment
# stage, zone capability, operational-purpose, and connection-point roles. The
# process performed by equipment or a system is modeled with watr:hasProcess.
# See docs/explanation/processes.md.
watr:Role-Backwash
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Backwash ;
    a sh:NodeShape ;
    owl:deprecated true ;
    rdfs:label "Role-Backwash" ;
    rdfs:comment "Deprecated. Model backwashing as watr:hasProcess watr:Process-Backwashing on the equipment or system that performs it." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Drain
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Drain ;
    a sh:NodeShape ;
    rdfs:label "Role-Drain" ;
    rdfs:comment "A connection point that empties a vessel below its working level, for maintenance or solids removal." ;
    rdfs:subClassOf s223:Role-Discharge ;
.

# An overflow is a discharge connection point.
watr:Role-Overflow
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Overflow ;
    a sh:NodeShape ;
    rdfs:label "Role-Overflow" ;
    rdfs:comment "A connection point that discharges liquid above a tank's working level." ;
    rdfs:subClassOf s223:Role-Discharge ;
.

watr:Role-MakeUp
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-MakeUp ;
    a sh:NodeShape ;
    rdfs:label "MakeUp" ;
    rdfs:comment "A connection point that admits water to replace what a process consumes or loses." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Feed
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Feed ;
    a sh:NodeShape ;
    rdfs:label "Feed" ;
    rdfs:comment "A connection point that admits the stream a process acts on." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Permeate 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Permeate ;
    a sh:NodeShape ;
    rdfs:label "Permeate" ;
    rdfs:comment "A connection point carrying the stream that has passed through a membrane." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
. 

watr:Role-Storage 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Storage ;
    a sh:NodeShape ;
    rdfs:label "Storage" ;
    rdfs:comment "The equipment holds water or sludge for later use rather than acting on it." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
. 

watr:Role-Aerobic 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Aerobic ;
    a sh:NodeShape ;
    rdfs:label "Aerobic" ;
    rdfs:comment "The zone is commissioned to run in an aerobic regime, with dissolved oxygen present. A design claim, not a reading: a basin whose blowers are off still carries it." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Anaerobic 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Anaerobic ;
    a sh:NodeShape ;
    rdfs:label "Anaerobic" ;
    rdfs:comment "The zone is commissioned to run in an anaerobic regime, without dissolved oxygen or nitrate." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Anoxic 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Anoxic ;
    a sh:NodeShape ;
    rdfs:label "Anoxic" ;
    rdfs:comment "The zone is commissioned to run in an anoxic regime, without dissolved oxygen and with nitrate present." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Equalization
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Equalization ;
    a sh:NodeShape ;
    rdfs:label "Equalization" ;
    rdfs:comment "The equipment buffers variation in flow or load so that the processes downstream of it see a steadier stream." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Detention 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Detention ;
    a sh:NodeShape ;
    rdfs:label "Detention" ;
    rdfs:comment "The equipment holds flow for a designed interval, typically to allow a reaction or settling to complete." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Retention 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Retention ;
    a sh:NodeShape ;
    rdfs:label "Retention" ;
    rdfs:comment "The equipment holds flow to attenuate a peak, typically stormwater, and releases it at a controlled rate." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Containment 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Containment ;
    a sh:NodeShape ;
    rdfs:label "Containment" ;
    rdfs:comment "The equipment confines a spill or an off-specification stream to keep it out of the rest of the plant." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Pretreatment
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Pretreatment ;
    a sh:NodeShape ;
    rdfs:label "Pretreatment" ;
    rdfs:comment "The equipment sits ahead of the main treatment train and conditions the influent for it." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

# Treatment stage, in the wastewater sense of Metcalf & Eddy: preliminary,
# primary, secondary, tertiary. These mirror S223 role names into the watr
# namespace but DO NOT carry the S223 meaning: s223:Role-Primary and
# s223:Role-Secondary denote primary and secondary *loops*. Always use the watr:
# terms for treatment stages. See docs/explanation/processes.md.
watr:Role-Primary
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Primary ;
    a sh:NodeShape ;
    rdfs:label "Primary" ;
    rdfs:comment "Primary treatment: the equipment belongs to the stage that removes settleable and floatable solids ahead of biological treatment. Not to be confused with s223:Role-Primary, which denotes a primary loop." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Secondary 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Secondary ;
    a sh:NodeShape ;
    rdfs:label "Secondary" ;
    rdfs:comment "Secondary treatment: the equipment belongs to the stage that removes biodegradable organics and suspended solids, typically biologically. Not to be confused with s223:Role-Secondary, which denotes a secondary loop." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Extended 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Extended ;
    a sh:NodeShape ;
    rdfs:label "Extended" ;
    rdfs:comment "The equipment is operated at an extended solids retention time." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Stepfeed 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Stepfeed ;
    a sh:NodeShape ;
    rdfs:label "Stepfeed" ;
    rdfs:comment "The equipment is fed at multiple points along its length rather than only at its head." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:Role-Tertiary 
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Tertiary ;
    a sh:NodeShape ;
    rdfs:label "Tertiary" ;
    rdfs:comment "Tertiary treatment: the equipment belongs to the polishing stage downstream of secondary treatment, for residual solids, nutrients or specific constituents." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.


# Thickening, dewatering and stabilization are identifiable from the equipment
# alone, so they are watr:Process types (see water/processtypes.ttl), not roles.
# A solids train is an s223:System whose members carry those processes; it needs
# no role of its own.

watr:Role-Posttreatment
    a s223:EnumerationKind-Role ;
    a watr:Class ;
    a watr:Role-Posttreatment ;
    a sh:NodeShape ;
    rdfs:label "Posttreatment" ;
    rdfs:comment "The equipment sits after the main treatment train and conditions the effluent for discharge or reuse." ;
    rdfs:subClassOf s223:EnumerationKind-Role ;
.

watr:EnumerationKind-Runtime
    a s223:EnumerationKind ;
    a watr:Class ;
    a s223:EnumerationKind-Runtime ;
    a sh:NodeShape ;
    rdfs:label "Runtime" ;
    rdfs:subClassOf s223:EnumerationKind ;
.
