@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix equip: <urn:nawi-water-ontology/equip#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology/processtypes>
    a owl:Ontology ;
    rdfs:label "NAWI Water Process Types Ontology" ;
    rdfs:comment "An ontology for types of unit process" .

# A process is an activity performed by equipment or by a system. A treatment
# objective is the intended change that activity achieves, and a role describes
# how an entity serves within a
# particular system. See docs/explanation/equipment_function.md.
watr:Process a watr:Class, sh:NodeShape ;
    rdfs:label "Water Process" ;
    skos:definition "A physical, chemical, or biological activity performed by a piece of equipment or by a system." ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "A human-readable label for the process type." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "A human-readable definition of the process type." ;
    ] ;
.

watr:Process-PhysicalProcess a watr:Class, watr:Process-PhysicalProcess ;
    rdfs:label "Physical Process" ;
    skos:definition "A unit process that relies on physical forces to separate or treat water." ;
    rdfs:subClassOf watr:Process .

watr:Process-Separation a watr:Class, watr:Process-Separation ;
    rdfs:label "Separation" ;
    skos:definition "The most generic process for separation of any two constituents." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

# Separation is too broad to be a step of a compound process: screening debris
# and stripping ammonia are separations, but neither is the step a train means
# when it says its biomass is separated from the treated water. That step is this
# one, and watr:Process-ActivatedSludge names it rather than the family above.
watr:Process-SolidLiquidSeparation a watr:Class, watr:Process-SolidLiquidSeparation ;
    rdfs:label "Solid-Liquid Separation" ;
    skos:definition "Separation of suspended solids from the liquid carrying them, by settling, flotation, filtration or centrifugal force. Distinguished from separations that act on dissolved or gaseous constituents." ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-Elutriation a watr:Class, watr:Process-Elutriation ;
    rdfs:label "Elutriation" ;
    skos:definition "A process that uses a stream of fluid flowing upward to separate a mixture of particles based on their size, shape, and density." ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-Screening a watr:Class, watr:Process-Screening ;
    rdfs:label "Screening" ;
    skos:definition "A unit process that removes large solids from water, such as leaves, branches, and other debris." ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-Sedimentation a watr:Class, watr:Process-Sedimentation ;
    rdfs:label "Sedimentation" ;
    skos:definition "A unit process that allows solids to settle out of water by gravity." ;
    rdfs:subClassOf watr:Process-SolidLiquidSeparation .



watr:Process-Stripping a watr:Class, watr:Process-Stripping ;
    rdfs:label "Stripping" ;
    skos:definition "Gas stripping for removal of dissolved gases such as ammonia and volatile organic compounds." ;
    rdfs:subClassOf watr:Process-Separation .

# Filtration is a Separation but not, as a family, a solid-liquid one: reverse
# osmosis and membrane distillation are filtration and retain dissolved species,
# not suspended solids. The filtration processes that do part solids from liquid
# say so themselves, below.
watr:Process-Filtration a watr:Class, watr:Process-Filtration ;
    rdfs:label "Filtration" ;
    skos:definition "A unit process that separates constituents from water by passing it through a filter or membrane, retaining what will not pass." ;
    rdfs:subClassOf watr:Process-Separation .

watr:Process-MediaFiltration a watr:Class, watr:Process-MediaFiltration ;
    rdfs:label "Media Filtration" ;
    skos:definition "A filtration process that uses a bed of media (as opposed to a membrane-based process)." ;
    rdfs:subClassOf watr:Process-Filtration, watr:Process-SolidLiquidSeparation .

watr:Process-SlowSandFiltration a watr:Class, watr:Process-SlowSandFiltration ;
    rdfs:label "Slow Sand Filtration" ;
    skos:definition "A filtration process that uses a bed of sand to remove impurities at low flow rates." ;
    rdfs:subClassOf watr:Process-MediaFiltration .

watr:Process-RapidSandFiltration a watr:Class, watr:Process-RapidSandFiltration ;
    rdfs:label "Rapid Sand Filtration" ;
    skos:definition "A filtration process that uses a bed of sand to remove impurities at high flow rates." ;
    rdfs:subClassOf watr:Process-MediaFiltration .

watr:Process-Flotation a watr:Class, watr:Process-Flotation ;
    rdfs:label "Flotation" ;
    skos:definition "A unit process that uses buoyancy to separate solids from water, often using air bubbles." ;
    rdfs:subClassOf watr:Process-SolidLiquidSeparation .

watr:Process-GasTransfer a watr:Class, watr:Process-GasTransfer ;
    rdfs:label "Gas Transfer" ;
    skos:definition "A unit process that transfers gases, such as oxygen or carbon dioxide, into or out of water." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Aeration a watr:Class, watr:Process-Aeration ;
    rdfs:label "Aeration" ;
    skos:definition "A unit process that aerates (i.e., transfers oxygen into water)." ;
    rdfs:subClassOf watr:Process-GasTransfer .

watr:Process-Mixing a watr:Class, watr:Process-Mixing ;
    rdfs:label "Mixing" ;
    skos:definition "A unit process that mixes water with chemicals or other substances to achieve a desired effect." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Recirculation a watr:Class, watr:Process-Recirculation ;
    rdfs:label "Recirculation" ;
    skos:definition "A process that returns a portion of a treated or intermediate flow back upstream to maintain hydraulic, solids, or biological performance." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .


watr:Process-Centrifugation a watr:Class, watr:Process-Centrifugation ;
    rdfs:label "Centrifugation" ;
    skos:definition "A process that uses centrifugal force to separate substances of different densities." ;
    rdfs:subClassOf watr:Process-SolidLiquidSeparation .

watr:Process-Solidification a watr:Class, watr:Process-Solidification ;
    rdfs:label "Solidification" ;
    skos:definition "A process of turning a liquid into a solid (e.g., freezing)." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Crystallization a watr:Class, watr:Process-Crystallization ;
    rdfs:label "Crystallization" ;
    skos:definition "A process of forming solid crystals from a solution." ;
    rdfs:subClassOf watr:Process-Solidification .

watr:Process-Evaporation a watr:Class, watr:Process-Evaporation ;
    rdfs:label "Evaporation" ;
    skos:definition "A process of turning a liquid into a vapor." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Condensation a watr:Class, watr:Process-Condensation ;
    rdfs:label "Condensation" ;
    skos:definition "A process of turning a vapor into a liquid." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-Adsorption a watr:Class, watr:Process-Adsorption ;
    rdfs:label "Adsorption" ;
    skos:definition "A process by which substances bind to a surface." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-GranularActivatedCarbon a watr:Class, watr:Process-GranularActivatedCarbon ;
    rdfs:label "Granular Activated Carbon (GAC)" ;
    skos:definition "A process that uses an activated carbon filter to adsorb impurities from water." ;
    rdfs:subClassOf watr:Process-Adsorption, watr:Process-Filtration .

watr:Process-MembraneProcess a watr:Class, watr:Process-MembraneProcess ;
    rdfs:label "Membrane Process" ;
    skos:definition "A process that uses a semi-permeable membrane to separate substances." ;
    rdfs:subClassOf watr:Process-Filtration .

watr:Process-ReverseOsmosis a watr:Class, watr:Process-ReverseOsmosis ;
    rdfs:label "Reverse Osmosis (RO)" ;
    skos:definition "Separation across a semi-permeable membrane under an applied pressure greater than the osmotic pressure of the feed, so that water passes and dissolved salts are retained." ;
    rdfs:subClassOf watr:Process-MembraneProcess .

watr:Process-ClosedCircuitReverseOsmosis a watr:Class, watr:Process-ClosedCircuitReverseOsmosis ;
    rdfs:label "Closed Circuit Reverse Osmosis (CCRO)" ;
    skos:definition "Reverse osmosis operated as a batch, with the concentrate recirculated to the feed side of the same module until a target recovery is reached and then displaced, rather than run as a once-through stage." ;
    rdfs:subClassOf watr:Process-ReverseOsmosis .

watr:Process-OsmoticallyAssistedReverseOsmosis a watr:Class, watr:Process-OsmoticallyAssistedReverseOsmosis ;
    rdfs:label "Osmotically Assisted Reverse Osmosis (OARO)" ;
    skos:definition "Reverse osmosis in which a saline sweep stream on the permeate side lowers the osmotic pressure difference across the membrane, so that a hypersaline feed can be concentrated further than the applied pressure would otherwise allow." ;
    rdfs:subClassOf watr:Process-ReverseOsmosis .

watr:Process-FeedReversalReverseOsmosis a watr:Class, watr:Process-FeedReversalReverseOsmosis ;
    rdfs:label "Feed Reversal Reverse Osmosis (FRRO)" ;
    skos:definition "Reverse osmosis in which the direction of feed flow through the train is periodically reversed, so that the elements which saw the most concentrated water see the feed next and scale that has begun to form is redissolved." ;
    rdfs:subClassOf watr:Process-ReverseOsmosis .

watr:Process-MembraneDistillation a watr:Class, watr:Process-MembraneDistillation ;
    rdfs:label "Membrane Distillation (MD)" ;
    skos:definition "Separation driven by a vapour pressure difference across a hydrophobic membrane: water evaporates on the warm feed side, crosses the membrane as vapour, and condenses on the cool permeate side, while the liquid feed is held back." ;
    rdfs:subClassOf watr:Process-MembraneProcess .

watr:Process-Electrodialysis a watr:Class, watr:Process-Electrodialysis ;
    rdfs:label "Electrodialysis" ;
    skos:definition "A process that uses ion-exchange membranes and an electric potential to separate ions from water." ;
    rdfs:subClassOf watr:Process-ChemicalProcess, watr:Process-PhysicalProcess .

watr:Process-ElectroDialyticCrystallization a watr:Class, watr:Process-ElectroDialyticCrystallization ;
    rdfs:label "Electro-Dialytic Crystallization (EDC)" ;
    skos:definition "A novel integrated process combining electrodialysis and crystallization for energy-efficient Zero-Liquid Discharge (ZLD) by maintaining a saturated brine stream." ;
    rdfs:subClassOf watr:Process-Electrodialysis, watr:Process-Crystallization .

watr:Process-Comminution a watr:Class, watr:Process-Comminution ;
    rdfs:label "Comminution" ;
    skos:definition "Process of reducing solid materials into smaller particles through mechanical forces such as crushing, grinding, impact, shear, or compression." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .


watr:Process-Composting a watr:Class, watr:Process-Composting ;
    rdfs:label "Composting" ;
    skos:definition "Biological degradation of organic materials under controlled aerobic conditions." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Stabilization, watr:TreatmentObjective-BiosolidsDisposal ;
    rdfs:subClassOf watr:Process-BiologicalProcess .

# Process-LandApplication and Process-Landfill were removed here: they named
# where biosolids end up rather than an activity performed on them, so they are
# watr:TreatmentObjective-LandApplication and watr:TreatmentObjective-Landfill in treatment objectives.ttl.

watr:Process-ChemicalProcess a watr:Class, watr:Process-ChemicalProcess ;
    rdfs:label "Chemical Process" ;
    skos:definition "A unit process that uses chemical reaction, chemical addition, or both to achieve a desired effect." ;
    rdfs:subClassOf watr:Process .

watr:Process-Dosing a watr:Class, watr:Process-Dosing ;
    rdfs:label "Dosing" ;
    skos:definition "Metered addition of a reagent to water, such as chlorine, coagulant, polymer, acid, base, or sulfite." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-Coagulation a watr:Class, watr:Process-Coagulation ;
    rdfs:label "Coagulation" ;
    skos:definition "A unit process that adds chemicals to water to cause small particles to clump together." ;
    rdfs:subClassOf watr:Process-Dosing .

watr:Process-Electrocoagulation a watr:Class, watr:Process-Electrocoagulation ;
    rdfs:label "Electrocoagulation (EC)" ;
    skos:definition "An electrified pretreatment technology using sacrificial anodes to release coagulant precursors for contaminant removal." ;
    rdfs:subClassOf watr:Process-Coagulation, watr:Process-PhysicalProcess .

watr:Process-Flocculation a watr:Class, watr:Process-Flocculation ;
    rdfs:label "Flocculation" ;
    skos:definition "A unit process that gently mixes water to allow coagulated particles to form larger clumps." ;
    rdfs:subClassOf watr:Process-ChemicalProcess, watr:Process-Mixing .

watr:Process-UVIrradiation a watr:Class, watr:Process-UVIrradiation ;
    rdfs:label "Ultraviolet Irradiation" ;
    skos:definition "Exposure of water to ultraviolet light. Named for what it does rather than what it is for: the same irradiation serves disinfection and, combined with an oxidant, advanced oxidation." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Disinfection ;
    rdfs:subClassOf watr:Process-PhysicalProcess .


watr:Process-ChlorineDosing a watr:Class, watr:Process-ChlorineDosing ;
    rdfs:label "Chlorine Dosing" ;
    skos:definition "Dosing of chlorine or chlorine compounds into water." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Disinfection ;
    rdfs:subClassOf watr:Process-Dosing .

# Process-Dechlorination was removed here. It named an objective, the way
# Process-UVDisinfection did before the split, and it is the clearest case of one
# treatment objective reached by several activities: dosing sulfite reduces the residual
# (Process-Reduction, a Process-Dosing), activated carbon adsorbs and
# catalyses it away (Process-Adsorption), and ultraviolet light photolyses it
# (Process-UVIrradiation). None of those is dechlorination; all of them
# dechlorinate. The objective is watr:TreatmentObjective-Dechlorination.

watr:Process-ThermalTreatment a watr:Class, watr:Process-ThermalTreatment ;
    rdfs:label "Thermal Treatment" ;
    skos:definition "Heating of water or biosolids, as in pasteurization. The process alone does not establish whether the intended treatment objective is disinfection, drying, hydrolysis, or another thermal result." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .



watr:Process-Oxidation a watr:Class, watr:Process-Oxidation ;
    rdfs:label "Oxidation" ;
    skos:definition "A unit process that adds oxidizing agents to water to remove contaminants or improve water quality." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-AdvancedOxidation a watr:Class, watr:Process-AdvancedOxidation ;
    rdfs:label "Advanced Oxidation Process (AOP)" ;
    skos:definition "Processes combining UV light with oxidants (e.g., UV-AOP) to destroy contaminants." ;
    rdfs:subClassOf watr:Process-Oxidation .

watr:Process-Electrooxidation a watr:Class, watr:Process-Electrooxidation ;
    rdfs:label "Electrooxidation (EO)" ;
    skos:definition "Oxidation of contaminants at the surface of an anode, and by oxidants generated there, under an applied electric current rather than by a dosed reagent." ;
    rdfs:subClassOf watr:Process-Oxidation, watr:Process-PhysicalProcess .

watr:Process-Ozonation a watr:Class, watr:Process-Ozonation ;
    rdfs:label "Ozonation" ;
    skos:definition "A water treatment process that uses ozone as an oxidant. The process alone does not establish whether the intended treatment objective is disinfection, oxidation of a contaminant, or taste-and-odour control." ;
    rdfs:subClassOf watr:Process-Oxidation .


watr:Process-ChemicalPrecipitation a watr:Class, watr:Process-ChemicalPrecipitation ;
    rdfs:label "Chemical Precipitation" ;
    skos:definition "Addition of a reagent that converts a dissolved constituent into an insoluble solid, so that it can be separated from the water. Which constituent it targets depends on the reagent, which is why the objective is stated on the equipment rather than here." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-Reduction a watr:Class, watr:Process-Reduction ;
    rdfs:label "Chemical Reduction" ;
    skos:definition "Mechanism by which contaminants are transformed through the gain of electrons." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-SolventExtraction a watr:Class, watr:Process-SolventExtraction ;
    rdfs:label "Solvent-Based Extraction" ;
    skos:definition "A non-membrane, non-thermal method using a solvent to selectively extract water from highly saline brines." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-HighDensitySludge a watr:Class, watr:Process-HighDensitySludge ;
    rdfs:label "High-Density Sludge (HDS) Process" ;
    skos:definition "Lime neutralization of an acidic stream, typically acid mine drainage, in which previously formed sludge is recycled into the reaction so that metal hydroxides precipitate onto existing particles and settle as a denser sludge." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Neutralization ;
    rdfs:subClassOf watr:Process-ChemicalProcess, watr:Process-PhysicalProcess .

watr:Process-IonExchange a watr:Class, watr:Process-IonExchange ;
    rdfs:label "Ion Exchange" ;
    skos:definition "A process in which ions are exchanged between a solution and an ion-exchange resin or membrane." ;
    rdfs:subClassOf watr:Process-ChemicalProcess, watr:Process-PhysicalProcess .

watr:Process-Electrolysis a watr:Class, watr:Process-Electrolysis ;
    rdfs:label "Electrolysis" ;
    skos:definition "A process that uses a direct electric current to drive an otherwise non-spontaneous chemical reaction." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-Combustion a watr:Class, watr:Process-Combustion ;
    rdfs:label "Combustion" ;
    skos:definition "A process that combusts biosolids or biogas." ;
    rdfs:subClassOf watr:Process-ChemicalProcess, watr:Process-PhysicalProcess .

# Incinerating biosolids disposes of them, which is why these two declare the
# treatment objective and their parent does not: Process-Combustion also covers burning
# biogas for energy, which disposes of nothing.
watr:Process-FluidizedBedIncineration a watr:Class, watr:Process-FluidizedBedIncineration ;
    rdfs:label "Fluidized Bed Incineration" ;
    skos:definition "A process that combusts a constantly moving bed of biosolids." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal ;
    rdfs:subClassOf watr:Process-Combustion .

watr:Process-MultipleHearthIncineration a watr:Class, watr:Process-MultipleHearthIncineration ;
    rdfs:label "Multiple Hearth Incineration (MHI)" ;
    skos:definition "A process that combusts biosolids as they move through a series of stacked hearths with controlled air flow." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-BiosolidsDisposal ;
    rdfs:subClassOf watr:Process-Combustion .

watr:Process-Cogeneration a watr:Class, watr:Process-Cogeneration ;
    rdfs:label "Cogeneration" ;
    skos:definition "A process that combusts biosolids or biogas to produce electricity and heat simultaneously." ;
    rdfs:subClassOf watr:Process-Combustion .

watr:Process-BiologicalProcess a watr:Class, watr:Process-BiologicalProcess ;
    rdfs:label "Biological Process" ;
    skos:definition "A unit process that utilizes biological activity for water treatment." ;
    rdfs:subClassOf watr:Process .




watr:Process-Nitrification a watr:Class, watr:Process-Nitrification ;
    rdfs:label "Nitrification" ;
    skos:definition "Process by which ammonia is oxidized to nitrite and subsequently nitrate." ;
    # Not TreatmentObjective-NitrogenRemoval; see the note on watr:TreatmentObjective-AmmoniaControl.
    watr:achievesTreatmentObjective watr:TreatmentObjective-AmmoniaControl ;
    rdfs:subClassOf watr:Process-BiologicalProcess .

watr:Process-Denitrification a watr:Class, watr:Process-Denitrification ;
    rdfs:label "Denitrification" ;
    skos:definition "Process by which nitrate is deoxidized to nitrogen gas and nitrogen oxides." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    rdfs:subClassOf watr:Process-BiologicalProcess .

watr:Process-EnhancedBiologicalPhosphorusRemoval a watr:Class, watr:Process-EnhancedBiologicalPhosphorusRemoval ;
    rdfs:label "Enhanced Biological Phosphorus Removal (EBPR)" ;
    skos:definition "Uptake of phosphorus into biomass beyond ordinary metabolic requirements, achieved by cycling the biomass through anaerobic and aerobic conditions." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-PhosphorusRemoval ;
    rdfs:subClassOf watr:Process-BiologicalProcess .

watr:Process-FiveStageBardenpho a watr:Class, watr:Process-FiveStageBardenpho ;
    rdfs:label "Five-Stage BARDENPHO (BARnard DENitrification and PHOsphorus removal)" ;
    skos:definition "A five-stage biological nutrient removal process specifically designed for nitrogen and phosphorus." ;
    watr:includesProcess watr:Process-Nitrification ;
    watr:includesProcess watr:Process-Denitrification ;
    watr:includesProcess watr:Process-EnhancedBiologicalPhosphorusRemoval ;
    watr:includesProcess watr:Process-Recirculation ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval, watr:TreatmentObjective-PhosphorusRemoval ;
    rdfs:subClassOf watr:Process-ActivatedSludge .

watr:Process-FourStageBardenpho a watr:Class, watr:Process-FourStageBardenpho ;
    rdfs:label "Four-Stage BARDENPHO (BARnard DENitrification and PHOsphorus removal)" ;
    skos:definition "A four-stage biological nutrient removal process with two anoxic and two aerobic zones." ;
    watr:includesProcess watr:Process-Nitrification ;
    watr:includesProcess watr:Process-Denitrification ;
    watr:includesProcess watr:Process-Recirculation ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    rdfs:subClassOf watr:Process-ActivatedSludge .

# The treatment-train process types below name *arrangements*, not things a
# single machine does -- which is why no equipment class requires any of them.
# They are asserted on an s223:System, and watr:includesProcess records the steps
# the train is made of so that watr:SystemProcessCoverageShape can check the
# members actually cover them. See docs/explanation/processes.md.
#
# A compound process uses watr:includesProcess for its constituent steps and
# rdfs:subClassOf for its process family. A Bardenpho is a kind of activated
# sludge process that includes nitrification and denitrification; it is not a
# kind of either constituent step.

watr:Process-ActivatedSludge a watr:Class, watr:Process-ActivatedSludge ;
    rdfs:label "Activated Sludge" ;
    skos:definition "Suspended-growth biological treatment in which biomass is aerated and subsequently separated from the treated water." ;
    watr:includesProcess watr:Process-Aeration ;
    # Require solid-liquid separation, not sedimentation specifically and not the
    # whole separation family. A conventional train satisfies this with
    # Process-Sedimentation, a membrane bioreactor with Process-Microfiltration or
    # Process-Ultrafiltration, and a DAF or centrifuge with their own processes.
    # Naming Process-Separation here instead would also accept a bar screen or an
    # air stripper, which separate something else entirely. Recirculation is
    # configuration-specific and is declared by the process types that require it.
    watr:includesProcess watr:Process-SolidLiquidSeparation ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-OrganicsRemoval ;
    rdfs:subClassOf watr:Process-BiologicalProcess .


watr:Process-AO a watr:Class, watr:Process-AO ;
    rdfs:label "Anoxic-Aerobic" ;
    skos:definition "Two-stage process with anoxic zone followed by aerobic zone for biological nitrogen removal." ;
    watr:includesProcess watr:Process-Nitrification ;
    watr:includesProcess watr:Process-Denitrification ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    rdfs:subClassOf watr:Process-ActivatedSludge .

watr:Process-MLE a watr:Class, watr:Process-MLE ;
    rdfs:label "Modified Ludzack-Ettinger (MLE)" ;
    skos:definition "Modification of AO with an internal recycle returning nitrate to the anoxic zone." ;
    watr:includesProcess watr:Process-Recirculation ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval ;
    rdfs:subClassOf watr:Process-AO .

watr:Process-A2O a watr:Class, watr:Process-A2O ;
    rdfs:label "Anaerobic-Anoxic-Oxic (A2O)" ;
    skos:definition "Anaerobic-anoxic-aerobic process for simultaneous biological nitrogen and phosphorus removal." ;
    watr:includesProcess watr:Process-Nitrification ;
    watr:includesProcess watr:Process-Denitrification ;
    watr:includesProcess watr:Process-EnhancedBiologicalPhosphorusRemoval ;
    watr:includesProcess watr:Process-Recirculation ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval, watr:TreatmentObjective-PhosphorusRemoval ;
    rdfs:subClassOf watr:Process-ActivatedSludge .

watr:Process-UCT a watr:Class, watr:Process-UCT ;
    rdfs:label "University of Cape Town (UCT)" ;
    skos:definition "Variant of A2O with modified recycle streams for phosphorus removal." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-NitrogenRemoval, watr:TreatmentObjective-PhosphorusRemoval ;
    rdfs:subClassOf watr:Process-A2O .

watr:Process-Biofiltration a watr:Class, watr:Process-Biofiltration ;
    rdfs:label "Biofiltration" ;
    skos:definition "A filtration method that uses biological processes to remove contaminants." ;
    rdfs:subClassOf watr:Process-BiologicalProcess, watr:Process-Filtration .

watr:Process-TricklingFiltration a watr:Class, watr:Process-TricklingFiltration ;
    rdfs:label "TricklingFiltration" ;
    skos:definition "Trickling filter using any media (e.g., plastic, sand, gravel, etc.)" ;
    rdfs:subClassOf watr:Process-Biofiltration .

watr:Process-BiologicallyActiveFiltration a watr:Class, watr:Process-BiologicallyActiveFiltration ;
    rdfs:label "Biologically Active Filtration (BAF)" ;
    skos:definition "A biologically activated filtration column." ;
    rdfs:subClassOf watr:Process-Biofiltration .

# Membrane processes, and solid-liquid separations: at these pore sizes what is
# retained is suspended -- solids, colloids, biomass -- which is what lets an MBR
# satisfy the separation step of Process-ActivatedSludge. Their coarser siblings
# under Process-MembraneProcess, reverse osmosis and membrane distillation,
# retain dissolved species instead and are deliberately not solid-liquid.
watr:Process-Microfiltration a watr:Class, watr:Process-Microfiltration ;
    rdfs:label "Microfiltration" ;
    skos:definition "Membrane filtration at a pore size of roughly 0.1 to 1 micron, retaining suspended solids, bacteria and larger colloids. The pore-size range characterizes the method; a model states its intended treatment objective separately." ;
    rdfs:subClassOf watr:Process-MembraneProcess, watr:Process-SolidLiquidSeparation .

watr:Process-Ultrafiltration a watr:Class, watr:Process-Ultrafiltration ;
    rdfs:label "Ultrafiltration" ;
    skos:definition "Membrane filtration at a pore size of roughly 0.01 to 0.1 micron, retaining colloids and macromolecules as well as the suspended solids microfiltration retains. The pore-size range characterizes the method; a model states its intended treatment objective separately." ;
    rdfs:subClassOf watr:Process-MembraneProcess, watr:Process-SolidLiquidSeparation .

watr:Process-Backwashing a watr:Class, watr:Process-Backwashing ;
    rdfs:label "Backwashing" ;
    skos:definition "A cleaning process in which water, and sometimes air, is driven backward through a filter or membrane system to remove accumulated solids." ;
    rdfs:subClassOf watr:Process-Cleaning .

watr:Process-AirScouring a watr:Class, watr:Process-AirScouring ;
    rdfs:label "Air Scouring" ;
    skos:definition "A cleaning process that uses injected air to dislodge accumulated foulants or solids from filter media or membrane surfaces." ;
    rdfs:subClassOf watr:Process-Cleaning .

watr:Process-Purging a watr:Class, watr:Process-Purging ;
    rdfs:label "Purging" ;
    skos:definition "A process that flushes retained liquid, solids, or gas from equipment or piping to restore operating conditions or prepare for another cycle." ;
    rdfs:subClassOf watr:Process-Cleaning .

# Stabilization names a treatment objective -- reduced volatile solids, pathogens and odor
# -- that is reached by more than one means. Unlike thickening, the means are
# genuine kinds of stabilization rather than siblings of it, so digestion and
# composting are modeled as subclasses and an instance needs only the specific
# one. It sits directly under watr:Process because it is achieved both
# biologically (digestion) and chemically (lime addition).

watr:Process-Digestion a watr:Class, watr:Process-Digestion ;
    rdfs:label "Digestion" ;
    skos:definition "A biological process that breaks down organic matter over a long duration in a tank." ;
    watr:achievesTreatmentObjective watr:TreatmentObjective-Stabilization ;
    rdfs:subClassOf watr:Process-BiologicalProcess .

watr:Process-Hydrolysis a watr:Class, watr:Process-Hydrolysis ;
    rdfs:label "Hydrolysis" ;
    skos:definition "A process reaction in which a water molecule is consumed to split a larger molecule into smaller fragments." ;
    rdfs:subClassOf watr:Process-ChemicalProcess .

watr:Process-ThermalHydrolysis a watr:Class, watr:Process-ThermalHydrolysis ;
    rdfs:label "Thermal Hydrolysis" ;
    skos:definition "A process that breaks down complex organic matter into soluble compounds using heat and pressure." ;
    rdfs:subClassOf watr:Process-Hydrolysis .

watr:Process-Cleaning a watr:Class, watr:Process-Cleaning ;
    rdfs:label "Cleaning" ;
    skos:definition "A maintenance-oriented process that removes accumulated solids, foulants, or residual materials from water treatment equipment." ;
    rdfs:subClassOf watr:Process-PhysicalProcess .

watr:Process-AnaerobicDigestion a watr:Class, watr:Process-AnaerobicDigestion ;
    rdfs:label "Anaerobic Digestion" ;
    skos:definition "A biological process that breaks down organic matter in the absence of oxygen." ;
    rdfs:subClassOf watr:Process-Digestion .

watr:Process-AerobicDigestion a watr:Class, watr:Process-AerobicDigestion ;
    rdfs:label "Aerobic Digestion" ;
    skos:definition "A biological process that breaks down organic matter in the presence of oxygen." ;
    rdfs:subClassOf watr:Process-Digestion .
