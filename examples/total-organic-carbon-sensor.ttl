@prefix : <urn:nawi-water-ontology/examples/toc-sensor#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:nawi-water-ontology/examples/toc-sensor>
    a owl:Ontology ;
    owl:imports <urn:nawi-water-ontology> ;
    rdfs:label "Total Organic Carbon Sensor Example" ;
    rdfs:comment "Example of a sensor observing a total organic carbon property using Organic Carbon as the substance and a water-specific aggregation marker on the property." ;
.

:toc_sample_point
    a s223:Junction ;
    s223:hasMedium s223:Fluid-Water ;
.

:toc_sensor
    a watr:TotalOrganicCompoundConcentrationSensor ;
    rdfs:label "TOC Sensor" ;
    s223:hasObservationLocation :toc_sample_point ;
    s223:observes :total_organic_carbon_property ;
.

:total_organic_carbon_property
    a s223:QuantifiableObservableProperty ;
    rdfs:label "Total Organic Carbon Concentration" ;
    s223:ofMedium s223:Fluid-Water ;
    s223:ofSubstance watr:Constituent-OrganicCarbon ;
    watr:hasAggregation watr:Aggregation-Total ;
    qudt:hasQuantityKind quantitykind:MassConcentration ;
    qudt:hasUnit unit:MilliGM-PER-L ;
.
