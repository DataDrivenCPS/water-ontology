@prefix : <urn:example/ro-mixture-test#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .

<urn:example/ro-mixture-test> a owl:Ontology ;
    rdfs:label "RO Constituent Compatibility Test" ;
    rdfs:comment "A ReverseOsmosisMembrane with a seawater feed, a freshwater permeate and a brine concentrate. The three media share s223:Constituent-H2O, so S223 accepts them on one piece of equipment." ;
    owl:imports
        <https://watermetadata.org/ontology/watr>,
        <http://data.ashrae.org/standard223/1.0/model/all> .

:ro a watr:ReverseOsmosisMembrane ;
    rdfs:label "RO constituent compatibility test" ;
    watr:hasProcess watr:Process-ReverseOsmosis ;
    s223:hasConnectionPoint :feed, :permeate, :concentrate .

:feed a s223:InletConnectionPoint ;
    rdfs:label "Seawater feed" ;
    s223:hasMedium watr:Water-Seawater ;
    s223:isConnectionPointOf :ro .

:permeate a s223:OutletConnectionPoint ;
    rdfs:label "Freshwater permeate" ;
    s223:hasMedium watr:Water-Freshwater ;
    s223:isConnectionPointOf :ro .

:concentrate a s223:OutletConnectionPoint ;
    rdfs:label "Brine concentrate" ;
    s223:hasMedium watr:Water-Brine ;
    s223:isConnectionPointOf :ro .
