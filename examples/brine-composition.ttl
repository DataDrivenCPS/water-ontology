@prefix : <urn:example/brine-composition#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <urn:nawi-water-ontology#> .

<urn:example/brine-composition>
    a owl:Ontology ;
    rdfs:label "Brine Composition Example" ;
    owl:imports <urn:nawi-water-ontology> ;
.

:Brine-15Percent
  # S223 medium enumerations use a self-type. This reusable salinity designation
  # is both a class and an instance of itself, and may be used directly as an
  # s223:hasMedium value. Composition does not inherit from watr:Water-Brine, so
  # both constituents are asserted here.
  a watr:Class ;
  a :Brine-15Percent ;
  a sh:NodeShape ;
  rdfs:comment "Brine-15Percent" ;
  rdfs:label "Brine-15Percent" ;
  rdfs:subClassOf watr:Water-Brine;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:hasValue 15 ;
      s223:ofConstituent watr:Salt-NaCl ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Salt Concentration" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:hasValue 85 ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Water Concentration" ;
    ] ;
  rdfs:comment "Brine-15Percent" ;
  rdfs:label "Brine-15Percent" ;
.

:Brine-5to10Percent
  # As above, repeat the complete composition on the specialized medium. The
  # salt range is 5-10%, so the complementary water range is 90-95%.
  a watr:Class ;
  a :Brine-5to10Percent ;
  a sh:NodeShape ;
  rdfs:comment "Brine-5to10Percent" ;
  rdfs:label "Brine-5to10Percent" ;
  rdfs:subClassOf watr:Water-Brine;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:hasAspect s223:Aspect-LowLimit ;
      s223:hasValue 5 ;
      s223:ofConstituent watr:Salt-NaCl ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Low Salt Concentration" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:hasAspect s223:Aspect-HighLimit ;
      s223:hasValue 10 ;
      s223:ofConstituent watr:Salt-NaCl ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "High Salt Concentration" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:hasAspect s223:Aspect-LowLimit ;
      s223:hasValue 90 ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Low Water Concentration" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:hasAspect s223:Aspect-HighLimit ;
      s223:hasValue 95 ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "High Water Concentration" ;
    ] ;
  rdfs:comment "Brine-5to10Percent" ;
  rdfs:label "Brine-5to10Percent" ;
.
