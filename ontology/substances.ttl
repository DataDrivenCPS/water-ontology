@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .

<https://watermetadata.org/ontology/modules/substances>
    a owl:Ontology ;
    rdfs:label "NAWI Water Substances Ontology" ;
    rdfs:comment "An ontology for water substances used in the NAWI project" ;
    owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
    # Prefix declarations for the SPARQL-based constraints defined in this module.
    sh:declare [ sh:prefix "s223" ; sh:namespace "http://data.ashrae.org/standard223#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "qudt" ; sh:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "unit" ; sh:namespace "http://qudt.org/vocab/unit/"^^xsd:anyURI ] ;
.
watr:Constituent-Metals
  a watr:Class ;
  a watr:Constituent-Metals ;
  a sh:NodeShape ;
  rdfs:comment "Constituent-Metals" ;
  rdfs:label "Constituent-Metals" ;
  rdfs:subClassOf s223:Medium-Constituent ;
.
watr:Constituent-Salt
  a watr:Class ;
  a watr:Constituent-Salt ;
  a sh:NodeShape ;
  rdfs:comment "Constituent-Salt" ;
  rdfs:label "Constituent-Salt" ;
  rdfs:subClassOf s223:Medium-Constituent ;
.
watr:Salt-NaCl
  a watr:Class ;
  a watr:Salt-NaCl ;
  a sh:NodeShape ;
  rdfs:comment "Salt-NaCl" ;
  rdfs:label "Salt-NaCl" ;
  rdfs:subClassOf watr:Constituent-Salt ;
.
watr:Water-Seawater
  a watr:Class ;
  a watr:Water-Seawater ;
  a sh:NodeShape ;
  rdfs:comment "Saline surface water (typical salinity ~3.5%) modeled as a constituent-bearing mixture of water and dissolved salt so that S223 can recognize the shared water constituent across aqueous media." ;
  rdfs:label "Water-Seawater" ;
  rdfs:subClassOf s223:Fluid-Water;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Water fraction" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent watr:Salt-NaCl ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Salt fraction" ;
    ] ;
.
watr:Water-Freshwater
  a watr:Class ;
  a watr:Water-Freshwater ;
  a sh:NodeShape ;
  rdfs:comment "Low-salinity surface or ground water modeled as a constituent-bearing mixture dominated by the water constituent so that S223 can recognize the shared water constituent across aqueous media." ;
  rdfs:label "Water-Freshwater" ;
  rdfs:subClassOf s223:Fluid-Water;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Water fraction" ;
    ] ;
.
watr:Water-Brackish
  a watr:Class ;
  a watr:Water-Brackish ;
  a sh:NodeShape ;
  rdfs:comment "Moderately saline water (typical salinity 0.5-3%) modeled as a constituent-bearing mixture of water and dissolved salt so that S223 can recognize the shared water constituent across aqueous media." ;
  rdfs:label "Water-Brackish" ;
  rdfs:subClassOf s223:Fluid-Water;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Water fraction" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent watr:Salt-NaCl ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Salt fraction" ;
    ] ;
.
watr:Water-Brine
  a watr:Class ;
  a watr:Water-Brine ;
  a sh:NodeShape ;
  rdfs:comment "Concentrated saline water modeled as a constituent-bearing mixture of water and dissolved salt so that S223 can recognize the shared water constituent across aqueous media." ;
  rdfs:label "Water-Brine" ;
  rdfs:subClassOf s223:Fluid-Water;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent watr:Salt-NaCl ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Salt fraction" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Water fraction" ;
    ] ;
.

watr:Fluid-Sludge
  a watr:Class ;
  a watr:Fluid-Sludge ;
  a sh:NodeShape ;
  rdfs:comment "A semi-solid slurry composed of water and solids." ;
  rdfs:label "Sludge" ;
  # Sludge is an aqueous slurry: this lets equipment that accepts water-based
  # fluids (for example, s223:Pump) retain the actual sludge medium on its
  # connection points rather than substituting the less-specific Fluid-Water.
  rdfs:subClassOf s223:Mix-Fluid, s223:Fluid-Water ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent watr:Constituent-Solids ;
      qudt:hasQuantityKind quantitykind:MassFraction ;
      qudt:hasUnit unit:PERCENT ;
    ] ;
.

# Base Class for Wastewater Treatment Chemicals
