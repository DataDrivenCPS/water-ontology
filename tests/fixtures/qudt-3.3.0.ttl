    qudt:symbol "n" ;
    qudt:wikidataMatch <http://www.wikidata.org/entity/Q867448> ;
    rdfs:comment "Applicable units are those of quantitykind:PrincipalQuantumNumber" ;
    rdfs:isDefinedBy <http://qudt.org/3.3.0/vocab/quantitykind> ;
    skos:broader quantitykind:QuantumNumber ;
    skos:closeMatch quantitykind:MagneticQuantumNumber,
        quantitykind:OrbitalAngularMomentumQuantumNumber,
        quantitykind:SpinQuantumNumber .

