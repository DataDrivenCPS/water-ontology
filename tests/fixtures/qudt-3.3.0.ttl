        unit:MilliDEG_C,
        unit:MilliK,
        unit:PlanckTemperature ;
    qudt:dbpediaMatch "http://dbpedia.org/resource/Temperature"^^xsd:anyURI ;
    qudt:hasDimensionVector qkdv:A0E0L0I0M0H1T0D0 ;
